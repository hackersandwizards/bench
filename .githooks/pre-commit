#!/usr/bin/env bash
# Pre-commit checks: betterleaks (secrets), shellcheck (*.sh and bash shebangs),
# zsh -n (*.zsh and zsh shebangs).
# NUL-delimited read so filenames with spaces or shell metacharacters can't
# trip the linter calls. while-read, not mapfile: the hook must survive
# /bin/bash 3.2 when it fires before the Brewfile installed bash 5.
set -e

# shellcheck source-path=SCRIPTDIR/../bin
# shellcheck source=../bin/_lib.sh
. "$(dirname "${BASH_SOURCE[0]}")/../bin/_lib.sh"

# Lint the staged blobs, not the working tree: after a partial `git add -p` the
# commit carries what the index holds. The whole index, so source= paths resolve.
idx=$(mktemp -d)
trap 'rm -rf "$idx"' EXIT
git checkout-index -a --prefix="$idx/"

staged=()
while IFS= read -r -d '' f; do staged+=("$f"); done \
  < <(git diff --cached --name-only --diff-filter=ACMR -z)
sh_files=()  zsh_files=()
for f in "${staged[@]}"; do
  if [[ $f == *.zsh ]]; then zsh_files+=("$f"); continue; fi
  # Classify the rest by shebang: a zsh script named .sh goes to zsh -n, since
  # it cannot be parsed by shellcheck (SC1071), and extensionless scripts (e.g.
  # bin/bench-*) would otherwise skip the linters. Bash is matched first, so a
  # bash shebang naming zsh in an argument is not taken from shellcheck, and
  # any other .sh goes there too. `|| true` keeps `set -e` from aborting where
  # read hits EOF.
  shebang=
  [[ -f $idx/$f ]] && IFS= read -r shebang < "$idx/$f" || true
  case $shebang in
    '#!'*bash*) sh_files+=("$f") ;;
    '#!'*zsh*)  zsh_files+=("$f") ;;
    *) if [[ $f == *.sh ]]; then sh_files+=("$f"); fi ;;
  esac
done

if have betterleaks; then
  # An inline allow marker is a human's call, not something a commit can add.
  betterleaks git --staged --redact --no-banner --ignore-gitleaks-allow
else
  echo "pre-commit: betterleaks not installed — refusing to commit unscanned" >&2
  echo "  install: brew install betterleaks" >&2
  exit 1
fi

if have shellcheck; then
  # -x lets shellcheck follow `# shellcheck source=...` annotations.
  ((${#sh_files[@]})) && (cd "$idx" && shellcheck -x "${sh_files[@]}")
else
  echo "pre-commit: shellcheck not installed — skipping shell lint" >&2
fi

if have zsh; then
  for f in "${zsh_files[@]}"; do zsh -n "$idx/$f"; done
else
  echo "pre-commit: zsh not installed — skipping zsh -n" >&2
fi
