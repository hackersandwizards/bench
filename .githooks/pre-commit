#!/usr/bin/env bash
# Pre-commit checks: betterleaks (secrets), shellcheck (*.sh), zsh -n (*.zsh).
# NUL-delimited read so filenames with spaces or shell metacharacters can't
# trip the linter calls. while-read, not mapfile: the hook must survive
# /bin/bash 3.2 when it fires before the Brewfile installed bash 5.
set -e

# shellcheck source-path=SCRIPTDIR/../bin
# shellcheck source=../bin/_lib.sh
. "$(dirname "${BASH_SOURCE[0]}")/../bin/_lib.sh"

staged=()
while IFS= read -r -d '' f; do staged+=("$f"); done \
  < <(git diff --cached --name-only --diff-filter=ACMR -z)
sh_files=()  zsh_files=()
for f in "${staged[@]}"; do
  case $f in
    *.sh)  sh_files+=("$f") ;;
    *.zsh) zsh_files+=("$f") ;;
    *)
      # Extensionless scripts (e.g. bin/bench-*) would otherwise skip the linters.
      # Classify by shebang. `|| continue` keeps `set -e` from aborting on an empty
      # file (read hits EOF) and the `-f` guard avoids a redirect error on deletes.
      [[ -f $f ]] || continue
      IFS= read -r shebang < "$f" || continue
      case $shebang in
        '#!'*zsh*)  zsh_files+=("$f") ;;
        '#!'*bash*) sh_files+=("$f") ;;
      esac
      ;;
  esac
done

if have betterleaks; then
  betterleaks git --staged --redact --no-banner
else
  echo "pre-commit: betterleaks not installed — refusing to commit unscanned" >&2
  echo "  install: brew install betterleaks" >&2
  exit 1
fi

if have shellcheck; then
  # -x lets shellcheck follow `# shellcheck source=...` annotations.
  ((${#sh_files[@]})) && shellcheck -x "${sh_files[@]}"
else
  echo "pre-commit: shellcheck not installed — skipping shell lint" >&2
fi

if have zsh; then
  for f in "${zsh_files[@]}"; do zsh -n "$f"; done
fi
