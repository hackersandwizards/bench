# skhd global hotkeys. https://github.com/koekeishiya/skhd
# Symlinked to ~/.config/skhd/skhdrc by install.sh.
# Script paths derive from that symlink's target so the repo can live anywhere
# (no hardcoded install location); skhd runs each command through a shell.

# Ctrl+Comma: tile all Ghostty windows into a dynamic grid.
# 0x2B = ANSI comma keycode.
ctrl - 0x2B : osascript -l JavaScript "$(dirname "$(readlink "$HOME/.config/skhd/skhdrc")")/../macos/ghostty-grid.js"

# Ctrl+Alt+I: reset IntelliJ IDEA tool-window layout. Quit IDEA first (script aborts otherwise).
# 0x22 = ANSI 'i' keycode. Silent; run the script in a terminal to see results.
ctrl + alt - 0x22 : "$(dirname "$(readlink "$HOME/.config/skhd/skhdrc")")/../macos/idea-reset-layout.py"
