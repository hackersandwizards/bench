#!/usr/bin/env python3
"""Snapshot and merge Safari's favorites bar (top-level leaves only).

  safari-favorites export [plist]            print title<TAB>url per favorite
  safari-favorites merge <snapshot> [plist]  prepend snapshot entries missing
                                             from the favorites bar
  safari-favorites missing <snapshot> [plist]  print snapshot entries absent
                                             from the bar (bench-doctor check)

Default plist: ~/Library/Safari/Bookmarks.plist (needs Full Disk Access).
"""
import os
import plistlib
import shutil
import subprocess
import sys
import uuid
from pathlib import Path
from xml.parsers.expat import ExpatError

DEFAULT_PLIST = Path.home() / "Library/Safari/Bookmarks.plist"


def load(path):
    try:
        with open(path, "rb") as f:
            return plistlib.load(f)
    except PermissionError:
        sys.exit(
            "No Full Disk Access: System Settings → Privacy & Security → "
            "Full Disk Access → enable your terminal, then re-run."
        )
    except FileNotFoundError:
        sys.exit(f"{path} missing — launch Safari once, quit it, then re-run.")
    # ValueError covers InvalidFileException (binary) and malformed XML values;
    # ExpatError covers truncated XML. Both escape plistlib.load as-is.
    except (ValueError, ExpatError):
        sys.exit(
            f"{path} is not a valid plist — corrupt? Restore it from a backup "
            "(next to it as *.backup, or Time Machine), then re-run."
        )


def favorites_bar(root):
    for child in root.get("Children", []):
        if child.get("Title") == "BookmarksBar":
            return child
    sys.exit("No BookmarksBar folder in plist — unexpected Safari bookmarks format.")


def export(plist_path):
    bar = favorites_bar(load(plist_path))
    for child in bar.get("Children", []):
        url = child.get("URLString")
        if child.get("WebBookmarkType") != "WebBookmarkTypeLeaf" or not url:
            continue
        title = child.get("URIDictionary", {}).get("title", "")
        # minimal: tabs/newlines in titles become spaces (keeps one line per bookmark)
        for ch in "\t\n\r":
            title = title.replace(ch, " ")
        print(f"{title}\t{url}")


# Dedupe scans the whole bar subtree while export stays top-level: a favorite
# the user filed into a folder within the bar must not be re-added on merge.
def subtree_urls(node):
    urls = set()
    for child in node.get("Children", []):
        if "URLString" in child:
            urls.add(child["URLString"])
        urls |= subtree_urls(child)
    return urls


def read_snapshot(path):
    entries = []
    try:
        f = open(path, encoding="utf-8")
    except OSError as e:
        sys.exit(f"cannot read snapshot: {e}")
    with f:
        for line in f:
            line = line.rstrip("\n")
            if not line:
                continue
            title, sep, url = line.rpartition("\t")
            if not sep or not url:
                print(f"skipping malformed line: {line!r}", file=sys.stderr)
                continue
            entries.append((title, url))
    return entries


# Read-only counterpart to merge with the same subtree dedupe, so a favorite
# the user later filed into a folder within the bar never reports as missing.
def missing(snapshot_path, plist_path):
    existing = subtree_urls(favorites_bar(load(plist_path)))
    for title, url in read_snapshot(snapshot_path):
        if url not in existing:
            print(f"{title}\t{url}")


def merge(snapshot_path, plist_path):
    is_live_plist = plist_path.expanduser().resolve() == DEFAULT_PLIST.resolve()
    if is_live_plist and subprocess.run(["pgrep", "-xq", "Safari"]).returncode == 0:
        sys.exit("Safari is running — quit it first so the plist write sticks.")

    entries = read_snapshot(snapshot_path)
    root = load(plist_path)
    bar = favorites_bar(root)
    existing = subtree_urls(bar)
    new = []
    for title, url in entries:
        if url in existing:
            continue
        existing.add(url)
        new.append(
            {
                "WebBookmarkType": "WebBookmarkTypeLeaf",
                "WebBookmarkUUID": str(uuid.uuid4()).upper(),
                "URLString": url,
                "URIDictionary": {"title": title},
            }
        )
    if not new:
        print("nothing to add")
        return

    bar["Children"] = new + bar.get("Children", [])
    tmp = f"{plist_path}.tmp"
    try:
        # Fixed name, overwritten per run: one-deep rollback, no backup pileup.
        shutil.copy2(plist_path, f"{plist_path}.backup")
        with open(tmp, "wb") as f:
            plistlib.dump(root, f, fmt=plistlib.FMT_BINARY)
        os.replace(tmp, plist_path)
    except OSError as e:
        # load() already proved read access, so this is not a Full Disk Access
        # problem; report the real error (locked file, unwritable dir, ...).
        sys.exit(f"write failed: {e}")
    print(f"added {len(new)}")


def main(argv):
    if len(argv) >= 2 and argv[1] == "export":
        export(Path(argv[2]) if len(argv) > 2 else DEFAULT_PLIST)
    elif len(argv) >= 3 and argv[1] == "merge":
        merge(argv[2], Path(argv[3]) if len(argv) > 3 else DEFAULT_PLIST)
    elif len(argv) >= 3 and argv[1] == "missing":
        missing(argv[2], Path(argv[3]) if len(argv) > 3 else DEFAULT_PLIST)
    else:
        sys.exit(__doc__.strip())


if __name__ == "__main__":
    main(sys.argv)
