#!/usr/bin/env bash
# Tests for _lib.sh helpers, bin/ scripts, and repo invariants — plain bash
# asserts, no framework.
# Run: bench-test   (exits non-zero if any assertion fails)
set -u

# shellcheck source-path=SCRIPTDIR
# shellcheck source=_lib.sh
. "$(dirname "$0")/_lib.sh"

passed=0 failed=0
assert_eq() {  # assert_eq label expected actual
  if [[ "$2" == "$3" ]]; then ok "$1"; passed=$((passed + 1))
  else fail "$1 — expected [$2], got [$3]"; failed=$((failed + 1)); fi
}
assert_ok() {  # assert_ok label cmd...  (expects zero exit)
  local label="$1"; shift
  if "$@" >/dev/null 2>&1; then ok "$label"; passed=$((passed + 1))
  else fail "$label — command failed: $*"; failed=$((failed + 1)); fi
}
assert_fail() {  # assert_fail label cmd...  (expects non-zero exit)
  local label="$1"; shift
  if "$@" >/dev/null 2>&1; then fail "$label — expected non-zero exit"; failed=$((failed + 1))
  else ok "$label"; passed=$((passed + 1)); fi
}

step "have()"
assert_ok   "finds an existing binary" have sh
assert_fail "rejects a missing binary" have zzz-not-a-real-binary

step "warn() ledger"
# The ledger's reason to exist: warns from piped subshells must reach it.
WARN_LOG=$(mktemp)
warn "parent" >/dev/null
echo x | { while read -r _; do warn "pipeline" >/dev/null; done; }
assert_eq "collects warns across subshell boundaries" $'parent\npipeline' "$(cat "$WARN_LOG")"
rm -f "$WARN_LOG"; WARN_LOG=""
warn "unledgered" >/dev/null
assert_ok "no ledger configured — warn still succeeds" true

step "sdkman_set_config()"
# Point the helper at a throwaway config — never touches the real ~/.sdkman.
cfg=$(mktemp)
printf 'sdkman_auto_answer=false\nsdkman_colour_enable=true\n' > "$cfg"
SDKMAN_CONFIG="$cfg"
sdkman_set_config sdkman_auto_answer true
assert_eq "updates an existing key"  "true" "$(awk -F= '/^sdkman_auto_answer=/{print $2}' "$cfg")"
assert_eq "leaves other keys intact" "true" "$(awk -F= '/^sdkman_colour_enable=/{print $2}' "$cfg")"
sdkman_set_config sdkman_new_key yes
assert_eq "appends a missing key"    "yes"  "$(awk -F= '/^sdkman_new_key=/{print $2}' "$cfg")"
sdkman_set_config sdkman_auto_answer true
assert_eq "is idempotent (one line)" "1"    "$(grep -c '^sdkman_auto_answer=true' "$cfg")"
rm -f "$cfg"

step "parse_* (docs/ snapshot parsers)"
fix=$(mktemp)
printf 'black v24.0.0\n- black\n- blackd\nruff v0.1.0\n- ruff\n' > "$fix"
assert_eq "parse_uv: tool names, skip executables" "black
ruff" "$(parse_uv "$fix")"
printf 'ripgrep v13.0.0:\n    rg\nfd-find v8.7.0:\n    fd\n' > "$fix"
assert_eq "parse_cargo: crate names, skip binaries" "ripgrep
fd-find" "$(parse_cargo "$fix")"
printf 'requests==2.31.0\nurllib3==2.0.0\n' > "$fix"
assert_eq "parse_pip: name before ==" "requests
urllib3" "$(parse_pip "$fix")"
printf 'Current default versions:\ngradle 9.5.1\njava 26.0.1-tem\n' > "$fix"
assert_eq "parse_sdk: candidate + version" "gradle 9.5.1
java 26.0.1-tem" "$(parse_sdk "$fix")"
# `json (2.19.8, default: 2.18.0)` is the dominant real shape: a user-updated
# version alongside the bundled one. It must be kept — the `^` anchor in the
# parser (`$2 !~ /^default:/`) is what distinguishes it from a `(default: X)`
# bundled-only gem. Without this case an unanchored regex would pass the test
# but silently drop every updated stdlib gem from replay.
printf 'rake (13.0.6)\nbigdecimal (default: 3.1.4)\njson (2.19.8, default: 2.18.0)\n' > "$fix"
assert_eq "parse_gem: keep user gems, skip bundled defaults" "rake
json" "$(parse_gem "$fix")"
printf '/opt/homebrew/lib\n├── npm@10.2.0\n├── typescript@5.3.3\n└── @angular/cli@17.0.0\n' > "$fix"
assert_eq "parse_node: strip version, drop npm, keep scope" "typescript
@angular/cli" "$(parse_node "$fix")"
# Line 4 is the post-replay shape: dockutil-written entries list a plain path
# (no file:// URL, no %XX). Line 5 is the bench-export shape: $HOME normalized
# to a token so the snapshot replays for any user.
# shellcheck disable=SC2016  # single quotes keep $HOME a literal token, as in real snapshots
printf 'Slack\tfile:///Applications/Slack.app/\tpersistentApps\t/U/dock.plist\tcom.tinyspeck.slackmacgap
Keynote Creator Studio\tfile:///Applications/Keynote%%20Creator%%20Studio.app/\tpersistentApps\t/U/dock.plist\tcom.apple.iWork.Keynote
Downloads\tfile:///Users/x/Downloads/\tpersistentOthers\t/U/dock.plist
Notion Calendar\t/Applications/Notion Calendar.app\tpersistentApps\t/U/dock.plist\t
Downloads\tfile://$HOME/Downloads/\tpersistentOthers\t/U/dock.plist\n' > "$fix"
assert_eq "parse_dock: URL, plain-path, and \$HOME forms" "/Applications/Slack.app
/Applications/Keynote Creator Studio.app
/Users/x/Downloads
/Applications/Notion Calendar.app
$HOME/Downloads" "$(parse_dock "$fix")"
# shellcheck disable=SC2016  # single quotes keep $HOME a literal token, as in real snapshots
printf 'Applications -> file:///Applications/\nDownloads -> file://$HOME/Library/Mobile%%20Documents/com~apple~CloudDocs/Downloads/\niCloud -> x-apple-finder:icloud\n' > "$fix"
assert_eq "parse_sidebar: name+url TSV, \$HOME expanded, built-ins dropped" "Applications	file:///Applications/
Downloads	file://$HOME/Library/Mobile%20Documents/com~apple~CloudDocs/Downloads/" "$(parse_sidebar "$fix")"
rm -f "$fix"

step "brew bottle-support guard"
# Shim `brew --repository` at a fixture Homebrew checkout and `sw_vers` at a
# chosen macOS version, so the parse + comparison run without the real system.
brewdir=$(mktemp -d)
mkdir -p "$brewdir/Library/Homebrew"
cat > "$brewdir/Library/Homebrew/macos_version.rb" <<'RB'
  SYMBOLS = {
    sequoia:  "15",
    sonoma:   "14",
    monterey: "12.7",
  }.freeze
RB
# Both shims are invoked indirectly (via brew_bottles_supported), so SC2329 off.
macos_ver=""
# shellcheck disable=SC2329
brew() { echo "$brewdir"; }
# shellcheck disable=SC2329
sw_vers() { echo "$macos_ver"; }
assert_eq "brew_newest_macos: highest major from the map" "15" "$(brew_newest_macos)"
macos_ver="14.5"; assert_ok   "supported when running major <= newest"            brew_bottles_supported
macos_ver="26.0"; assert_fail "unsupported when running major > newest"           brew_bottles_supported
macos_ver="";     assert_ok   "fail-open (supported) when the version is unknown" brew_bottles_supported
unset -f brew sw_vers
rm -rf "$brewdir"

step "safari-favorites merge"
sf="$REPO_ROOT/bin/safari-favorites"
tdir=$(mktemp -d)
python3 - "$tdir/b.plist" <<'PY'
import plistlib, sys
leaf = lambda t, u: {"WebBookmarkType": "WebBookmarkTypeLeaf", "WebBookmarkUUID": "X",
                     "URLString": u, "URIDictionary": {"title": t}}
bar = {"Title": "BookmarksBar", "WebBookmarkType": "WebBookmarkTypeList", "WebBookmarkUUID": "Y",
       "Children": [leaf("b", "https://b/"),
                    {"Title": "f", "WebBookmarkType": "WebBookmarkTypeList", "WebBookmarkUUID": "Z",
                     "Children": [leaf("c", "https://c/")]}]}
plistlib.dump({"Children": [bar], "WebBookmarkFileVersion": 1},
              open(sys.argv[1], "wb"), fmt=plistlib.FMT_BINARY)
PY
printf 'a\thttps://a/\nb\thttps://b/\nc\thttps://c/\n' > "$tdir/snap.txt"
assert_ok "merge runs against fixture" "$sf" merge "$tdir/snap.txt" "$tdir/b.plist"
merged=$'a\thttps://a/\nb\thttps://b/'
assert_eq "prepends only missing URLs (subtree dedupe)" "$merged" "$("$sf" export "$tdir/b.plist")"
assert_ok "idempotent merge exits ok" "$sf" merge "$tdir/snap.txt" "$tdir/b.plist"
assert_eq "idempotent — re-run adds nothing" "$merged" "$("$sf" export "$tdir/b.plist")"
# `missing` must count c (in a folder within the bar) as present — subtree scan.
assert_eq "missing: empty when all snapshot URLs in bar subtree" \
  "" "$("$sf" missing "$tdir/snap.txt" "$tdir/b.plist")"
printf 'd\thttps://d/\n' >> "$tdir/snap.txt"
assert_eq "missing: lists snapshot entries absent from the bar" \
  $'d\thttps://d/' "$("$sf" missing "$tdir/snap.txt" "$tdir/b.plist")"
assert_fail "missing: non-zero exit on absent snapshot" \
  "$sf" missing "$tdir/nope.txt" "$tdir/b.plist"
assert_eq "missing: clean error, no traceback, on absent snapshot" \
  "0" "$("$sf" missing "$tdir/nope.txt" "$tdir/b.plist" 2>&1 | grep -c Traceback)"
rm -rf "$tdir"

step "missing_fonts()"
fdir=$(mktemp -d)
touch "$fdir/Installed Font.ttf" "$fdir/Other.otf"
printf 'Installed Font.ttf\nMissing Font.ttf\n' > "$fdir/checklist.txt"
assert_eq "reports checklist entries absent from the dir (spaces survive)" \
  "Missing Font.ttf" "$(missing_fonts "$fdir/checklist.txt" "$fdir")"
printf 'Installed Font.ttf\n' > "$fdir/checklist.txt"
assert_eq "empty when everything is present" "" "$(missing_fonts "$fdir/checklist.txt" "$fdir")"
rm -rf "$fdir"

step "install.sh istep self-count"
# STEP_TOTAL greps for '^istep ' — an indented call would increment STEP_N
# without being counted, printing "Step 14/13". Fails here first instead.
assert_fail "no indented istep calls (self-count stays exact)" \
  grep -qE '^[[:space:]]+istep ' "$REPO_ROOT/install.sh"

step "$passed passed, $failed failed"
(( failed == 0 ))
