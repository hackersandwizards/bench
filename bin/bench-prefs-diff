#!/usr/bin/env bash
# Producer tool: capture a settings deviation as `defaults` keys for macos.sh.
#   bench-prefs-diff snap    # before flipping the setting in the UI
#   bench-prefs-diff diff    # after: shows what changed
set -u

# shellcheck source-path=SCRIPTDIR
# shellcheck source=_lib.sh
. "$(dirname "$0")/_lib.sh"

# $HOME, not /tmp: a fixed name in world-writable /tmp invites symlink games.
SNAP="${XDG_CACHE_HOME:-$HOME/.cache}/bench-prefs-snap"
dump() { defaults read 2>/dev/null; defaults -currentHost read 2>/dev/null; }

case "${1:-}" in
  snap)
    dump > "$SNAP"
    ok "snapshot taken — change the setting in the UI, then run: bench-prefs-diff diff"
    ;;
  diff)
    if [[ ! -s "$SNAP" ]]; then
      fail "no snapshot — run 'bench-prefs-diff snap' first"
      exit 1
    fi
    dump | diff "$SNAP" - && ok "no changes since snap"
    ;;
  *)
    echo "usage: bench-prefs-diff snap|diff"
    exit 1
    ;;
esac
