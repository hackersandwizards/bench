#!/usr/bin/env bash
# Health check for the dotfiles setup.
set -u

# shellcheck source-path=SCRIPTDIR
# shellcheck source=_lib.sh
. "$(dirname "$0")/_lib.sh"

echo "=== Environment ==="
if [[ -n "${ZSH_SETTINGS_DIR:-}" ]]; then
  ok "ZSH_SETTINGS_DIR=$ZSH_SETTINGS_DIR"
else
  # This script is bash, so the var is unset by construction and warning about it
  # would fire on every unattended run. Ask the shell that actually sets it.
  zdir=$(have zsh && zsh -ic 'print -r -- ${ZSH_SETTINGS_DIR:-}' 2>/dev/null | tail -1)
  if [[ -n "$zdir" ]]; then
    ok "ZSH_SETTINGS_DIR=$zdir (interactive zsh)"
  else
    warn "ZSH_SETTINGS_DIR unset even in an interactive zsh — is init.zsh sourced from ~/.zshrc?"
  fi
fi

echo
echo "=== Required tools ==="
# antidote is a zsh function (sourced from brew), not a PATH binary
check "antidote" test -f "$ANTIDOTE_SH"
for cmd in starship zoxide fzf eza bat fd rg gh glab git delta lazygit jaq xh cmake ninja \
  clang-format clang-tidy; do
  check "$cmd" command -v "$cmd"
done
# The Brewfile ships rust, not rustup. Leftover rustup shims sit ahead of
# /opt/homebrew/bin in PATH and nothing updates their toolchain anymore.
[[ -x "$HOME/.cargo/bin/rustc" ]] \
  && warn "rustup shims in ~/.cargo/bin shadow brew's rust — run: rustup self uninstall"

echo
echo "=== Optional tools ==="
for cmd in atuin direnv stow gitleaks shellcheck claude; do
  check "$cmd" command -v "$cmd"
done

echo
echo "=== Stow symlinks ==="
for rel in "${STOW_FILES[@]}"; do
  if [[ -L "$HOME/$rel" ]]; then
    ok "$rel -> $(readlink "$HOME/$rel")"
  elif [[ -e "$HOME/$rel" ]]; then
    warn "$rel: real file (not Stow-managed)"
  else
    warn "$rel: missing"
  fi
done

echo
echo "=== Config symlinks + skhd ==="
# readlink-compare, not -L: a dangling or foreign-repo symlink must fail.
check "ghostty config -> repo" test "$(readlink "$HOME/.config/ghostty/config.ghostty" 2>/dev/null)" = "$REPO_ROOT/ghostty/config.ghostty"
check "skhdrc -> repo" test "$(readlink "$HOME/.config/skhd/skhdrc" 2>/dev/null)" = "$REPO_ROOT/skhd/skhdrc"
check "skhd running" pgrep -xq skhd

echo
echo "=== Fonts ==="
# Ghostty's configured font (ghostty/config.ghostty); cask font-jetbrains-mono
# and manual installs both land in ~/Library/Fonts.
if compgen -G "$HOME/Library/Fonts/JetBrainsMono*" > /dev/null; then
  ok "JetBrains Mono installed (Ghostty font)"
else
  warn "JetBrains Mono missing — Ghostty falls back (brew install --cask font-jetbrains-mono)"
fi
if [[ -s "$REPO_ROOT/docs/fonts.txt" ]]; then
  n=$(missing_fonts "$REPO_ROOT/docs/fonts.txt" "$HOME/Library/Fonts" | wc -l | tr -d ' ')
  if (( n == 0 )); then
    ok "all fonts from docs/fonts.txt present"
  else
    warn "$n fonts from docs/fonts.txt missing — restore manually from a backup"
  fi
fi

echo
echo "=== Repo state ==="
hp=$(hooks_path)
if [[ "$hp" == ".githooks" ]]; then
  ok "core.hooksPath = .githooks"
else
  warn "core.hooksPath = $hp (run install.sh to fix)"
fi
if [[ ! -f "$REPO_ROOT/secrets.zsh" ]]; then
  warn "secrets.zsh missing (optional)"
# Verify what install.sh enforces: a hand copy can re-widen the perms.
elif [[ "$(stat -f %Lp "$REPO_ROOT/secrets.zsh")" == 600 ]]; then
  ok "secrets.zsh present (600)"
else
  warn "secrets.zsh perms are $(stat -f %Lp "$REPO_ROOT/secrets.zsh"), not 600 — chmod 600 secrets.zsh"
fi
check "docs/safari-favorites.txt" test -s "$REPO_ROOT/docs/safari-favorites.txt"
check "docs/secret-keys.txt" test -s "$REPO_ROOT/docs/secret-keys.txt"
if [[ -s "$REPO_ROOT/docs/secret-keys.txt" ]]; then
  missing_keys=$(grep -vE '^(#|$)' "$REPO_ROOT/docs/secret-keys.txt" | while IFS= read -r k; do
    # Invalid names never reach secrets.zsh (install.sh skips them with its
    # own warn), so reporting them as missing would point at a dead end.
    valid_key_name "$k" || continue
    grep -q "^export $k=" "$REPO_ROOT/secrets.zsh" 2>/dev/null || printf '%s\n' "$k"
  done)
  if [[ -z "$missing_keys" ]]; then
    ok "all docs/secret-keys.txt keys set in secrets.zsh"
  else
    warn "keys missing from secrets.zsh — run install.sh:"
    printf '%s\n' "$missing_keys" | indent
  fi
fi

echo
echo "=== Applied outcomes (macos.sh + docs/ snapshots) ==="
# minimal: one sentinel key stands in for the whole macos.sh run. Tap-to-click
# is what a machine that never ran it visibly misses first.
if [[ "$(defaults read com.apple.AppleMultitouchTrackpad Clicking 2>/dev/null)" == "1" ]]; then
  ok "tap-to-click enabled (macos.sh applied)"
else
  warn "tap-to-click off — run ./macos.sh, then log out/restart"
fi
# No second sentinel for the same macos.sh run: the desktop picture is the one
# macos.sh setting macOS itself keeps rewriting (a Photos wallpaper source swaps
# the file underneath), so it warned every day about a state that is fine.
# Stderr flows through on purpose: the script's own message (Full Disk Access,
# Safari never launched, corrupt plist) is the diagnosis, not a guess here.
if ! missing_favs=$("$REPO_ROOT/bin/safari-favorites" missing "$REPO_ROOT/docs/safari-favorites.txt"); then
  warn "cannot read Safari favorites (see message above)"
elif [[ -z "$missing_favs" ]]; then
  ok "all snapshot favorites present in Safari"
else
  warn "snapshot favorites missing from Safari — re-run install.sh:"
  printf '%s\n' "$missing_favs" | head -n 5 | indent
fi
# Dock is ordered (the layout IS the order); the sidebar is compared as a set.
# The snapshot side keeps only on-disk apps: the replay skips missing ones by
# design, so the check must promise no more than the replayer does.
if have dockutil && [[ -s "$REPO_ROOT/docs/dock.txt" ]]; then
  snap_dock=$(parse_dock "$REPO_ROOT/docs/dock.txt" | while IFS= read -r p; do
    [[ -e "$p" ]] && printf '%s\n' "$p"
  done)
  if [[ "$snap_dock" == "$(current_dock)" ]]; then
    ok "Dock matches docs/dock.txt"
  else
    warn "Dock drifted from docs/dock.txt — bench-export to keep it, install.sh to replay"
  fi
fi
if have mysides && [[ -s "$REPO_ROOT/docs/finder-sidebar.txt" ]]; then
  if [[ "$(parse_sidebar "$REPO_ROOT/docs/finder-sidebar.txt" | sort)" == "$(current_sidebar | sort)" ]]; then
    ok "Finder sidebar matches docs/finder-sidebar.txt"
  else
    warn "Finder sidebar drifted from docs/finder-sidebar.txt — bench-export to keep it, install.sh to replay"
  fi
fi

echo
echo "=== Default repos (docs/repos.txt) ==="
# A missing target is more often a moved clone than an uncloned repo, and
# install.sh would then clone a stale path or a dead URL. So locate the clone by
# its remote first: the URL is the repo's identity, the path is just where it sat.
# True only when the host answered and denied the repo. An offline run fails the
# same call with "could not resolve host", and calling that dead would retire a
# good entry, so anything but an explicit denial falls through to install.sh.
# GIT_TERMINAL_PROMPT=0 because an unattended run must fail, never wait for input.
# A private repo whose credentials are missing also reads as gone; the gh/glab
# auth checks above are what make that unlikely here.
remote_gone() {
  local out
  out=$(GIT_TERMINAL_PROMPT=0 git ls-remote "$1" 2>&1 >/dev/null) && return 1
  printf '%s' "$out" | grep -qiE 'not found|does not exist|access denied|403|404'
}
find_clone() {  # find_clone <url> [retried] -> path relative to $HOME, or non-zero
  local want d now
  have fd || return 1
  want=$(repo_slug "$1")
  while read -r d; do
    d=${d%/}; d=${d%/.git}
    [[ "$(repo_slug "$(git -C "$d" remote get-url origin 2>/dev/null)")" == "$want" ]] || continue
    printf '%s' "${d#"$HOME"/}"; return 0
  done < <(fd -H -t d -d 6 '^\.git$' "$HOME/dev" "$HOME/opt" 2>/dev/null)
  # No clone carries this URL. A rename on the host leaves docs/repos.txt on the
  # old name while the clone already carries the new one, so ask the host once
  # and look again — the second argument is what stops that from recurring.
  [[ -z "${2:-}" ]] || return 1
  now=$(canonical_url "$1")
  [[ "$now" != "$1" ]] && find_clone "$now" retried
}
if [[ -s "$REPO_ROOT/docs/repos.txt" ]]; then
  while read -r target url; do
    if [[ -d "$HOME/$target/.git" ]]; then
      ok "repo: $target"
    elif moved=$(find_clone "$url"); then
      # Reached through a rename, the entry's URL is stale too, and saying only
      # "fix the path" would leave it pointing at a name the host serves today
      # and drops the day something else claims it. The clone's own origin is
      # the answer, put back in the https form docs/repos.txt is written in.
      origin=$(repo_slug "$(git -C "$HOME/$moved" remote get-url origin 2>/dev/null)")
      if [[ "$origin" == "$(repo_slug "$url")" ]]; then
        warn "repo: $target missing, but its remote is cloned at $moved — fix the path in docs/repos.txt"
      else
        warn "repo: $target missing; $url was renamed and is cloned at $moved — set both to https://$origin.git in docs/repos.txt"
      fi
    elif remote_gone "$url"; then
      warn "repo: $target missing and $url is gone — the docs/repos.txt entry is dead"
    else
      warn "repo: $target missing — run install.sh"
    fi
  done < <(parse_repos "$REPO_ROOT/docs/repos.txt")
else
  warn "docs/repos.txt missing/empty"
fi

echo
echo "=== IntelliJ JDK pins ==="
# bench-update prunes superseded SDKs; IntelliJ pins JDKs by absolute path, so a
# prune silently leaves dangling project SDKs. IntelliJ rewrites this file on
# exit, so this only reports: repoint it in the IDE, never from a script.
shopt -s nullglob
jdk_tables=("$HOME/Library/Application Support/JetBrains"/*/options/jdk.table.xml)
shopt -u nullglob
if (( ${#jdk_tables[@]} == 0 )); then
  skip "no IntelliJ jdk.table.xml"
else
  for t in "${jdk_tables[@]}"; do
    ide=$(basename "$(dirname "$(dirname "$t")")")
    dangling=$(grep -o 'candidates/[^"!/]*/[^"!/]*' "$t" | sort -u \
      | while read -r rel; do [[ -d "$HOME/.sdkman/$rel" ]] || printf '%s ' "${rel#candidates/}"; done)
    if [[ -z "$dangling" ]]; then
      ok "$ide JDK pins all resolve"
    else
      warn "$ide pins missing SDKs: ${dangling% } — repoint the project SDK in IntelliJ"
    fi
  done
fi

echo
echo "=== Git auth ==="
for tool in gh glab; do
  if "$tool" auth status >/dev/null 2>&1; then
    ok "$tool auth ok"
  else
    warn "$tool auth not configured"
  fi
done

echo
echo "=== Startup ==="
zsh -i -c exit >/dev/null 2>&1   # warm-up: absorb any stale-cache regeneration
# A clean interactive shell prints nothing on stderr; capture it so a silent
# startup error (like fzf's "can't change option: zle") surfaces as a warning.
startup_err=$(zsh -i -c exit 2>&1 >/dev/null)
if [[ -z "$startup_err" ]]; then
  ok "interactive startup clean (no stderr)"
else
  warn "interactive startup emits stderr:"
  printf '%s\n' "$startup_err" | indent
fi
# $EPOCHREALTIME is empty under bash 3.2 (macOS's /bin/bash). Guard it so a
# wrong interpreter reports honestly instead of a false 0ms.
if [[ -n "${EPOCHREALTIME:-}" ]]; then
  # Best of three: a single sample swings 40%+ with system load, and the minimum
  # is the least-contended figure, so the reported number stays reproducible.
  best=""
  for _ in 1 2 3; do
    start=${EPOCHREALTIME/./}
    zsh -i -c exit >/dev/null 2>&1
    end=${EPOCHREALTIME/./}
    ms=$(( (end - start) / 1000 ))
    { [[ -z $best ]] || (( ms < best )); } && best=$ms
  done
  echo "  zsh -i -c exit took ${best}ms (best of 3)"
else
  warn "startup timing needs bash 5+ for \$EPOCHREALTIME (running $BASH_VERSION)"
fi
