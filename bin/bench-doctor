#!/usr/bin/env bash
# Health check for the dotfiles setup.
set -u

# shellcheck source-path=SCRIPTDIR
# shellcheck source=_lib.sh
. "$(dirname "$0")/_lib.sh"

echo "=== Environment ==="
if [[ -n "${ZSH_SETTINGS_DIR:-}" ]]; then
  ok "ZSH_SETTINGS_DIR=$ZSH_SETTINGS_DIR"
else
  warn "ZSH_SETTINGS_DIR not set in current shell (only set by init.zsh)"
fi

echo
echo "=== Required tools ==="
# antidote is a zsh function (sourced from brew), not a PATH binary
check "antidote" test -f "$ANTIDOTE_SH"
for cmd in starship zoxide fzf eza bat fd rg gh glab git delta lazygit jaq xh; do
  check "$cmd" command -v "$cmd"
done

echo
echo "=== Optional tools ==="
for cmd in atuin direnv stow gitleaks shellcheck claude; do
  check "$cmd" command -v "$cmd"
done

echo
echo "=== Stow symlinks ==="
for rel in "${STOW_FILES[@]}"; do
  if [[ -L "$HOME/$rel" ]]; then
    ok "$rel -> $(readlink "$HOME/$rel")"
  elif [[ -e "$HOME/$rel" ]]; then
    warn "$rel: real file (not Stow-managed)"
  else
    warn "$rel: missing"
  fi
done

echo
echo "=== Repo state ==="
hp=$(hooks_path)
if [[ "$hp" == ".githooks" ]]; then
  ok "core.hooksPath = .githooks"
else
  warn "core.hooksPath = $hp (run install.sh to fix)"
fi
if [[ -f "$REPO_ROOT/secrets.zsh" ]]; then
  ok "secrets.zsh present"
else
  warn "secrets.zsh missing (optional)"
fi

echo
echo "=== Git auth ==="
for tool in gh glab; do
  if "$tool" auth status >/dev/null 2>&1; then
    ok "$tool auth ok"
  else
    warn "$tool auth not configured"
  fi
done

echo
echo "=== Startup ==="
zsh -i -c exit >/dev/null 2>&1   # warm-up: absorb any stale-cache regeneration
# Health: a clean interactive shell prints nothing on stderr. Capturing it here
# turns a silent startup error (like fzf's "can't change option: zle") into a
# visible warning instead of noise the user never connects to a cause. Runs on
# any interpreter — unlike the timing below, it needs no $EPOCHREALTIME.
startup_err=$(zsh -i -c exit 2>&1 >/dev/null)
if [[ -z "$startup_err" ]]; then
  ok "interactive startup clean (no stderr)"
else
  warn "interactive startup emits stderr:"
  printf '%s\n' "$startup_err" | sed 's/^/    /'
fi
# bash 5+ exposes $EPOCHREALTIME (microsecond float, no fork). Strip the dot to
# get an integer microseconds count, then divide. It is empty under bash 3.2
# (macOS's /bin/bash) — guard it so a wrong interpreter reports honestly instead
# of a false 0ms. `env bash` normally resolves to brew's bash 5.x.
if [[ -n "${EPOCHREALTIME:-}" ]]; then
  # Report the best of three runs. A single sample swings 40%+ with system load —
  # a cold run here measured 135ms against a 91ms steady state — and the minimum
  # is the cleanest, least-contended figure, so the number stays reproducible.
  best=""
  for _ in 1 2 3; do
    start=${EPOCHREALTIME/./}
    zsh -i -c exit >/dev/null 2>&1
    end=${EPOCHREALTIME/./}
    ms=$(( (end - start) / 1000 ))
    { [[ -z $best ]] || (( ms < best )); } && best=$ms
  done
  echo "  zsh -i -c exit took ${best}ms (best of 3)"
else
  warn "startup timing needs bash 5+ for \$EPOCHREALTIME (running $BASH_VERSION)"
fi
