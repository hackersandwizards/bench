#!/usr/bin/env bash
set -u

# shellcheck source-path=SCRIPTDIR
# shellcheck source=_lib.sh
. "$(dirname "$0")/_lib.sh"

# Neither the T3 service nor commands Codex runs read exports.zsh. Without
# these variables, Node and Bun fill the temp folder with compile caches
# without reporting an error.
check_runtime_caches() {
  local service="$HOME/.t3/service.env" codex="$HOME/.codex/config.toml"
  local file target missing setting key value
  local settings=(NODE_DISABLE_COMPILE_CACHE=1 BUN_RUNTIME_TRANSPILER_CACHE_PATH=0)
  [[ -e "$service" || -e "$codex" ]] || return 0

  echo
  echo "=== Runtime caches ==="
  for file in "$service" "$codex"; do
    [[ -e "$file" ]] || continue
    target=$file
    [[ "$file" == "$codex" ]] && target+=" [shell_environment_policy.set]"
    if ! [[ -f "$file" ]] || ! missing=$(
      if [[ "$file" == "$service" ]]; then
        node - "$file" "${settings[@]}" <<'JS'
        const { readFileSync } = require("node:fs");
        const { parseEnv } = require("node:util");

        const [file, ...settings] = process.argv.slice(2);
        const values = parseEnv(readFileSync(file, "utf8"));
        for (const setting of settings) {
          const [key, expected] = setting.split("=");
          if (values[key] !== expected) console.log(key);
        }
JS
      else
        python3 -B - "$file" "${settings[@]}" <<'PYTHON'
import sys
import tomllib
from pathlib import Path

file = Path(sys.argv[1])
expected = dict(setting.split("=") for setting in sys.argv[2:])
values = tomllib.loads(file.read_text(encoding="utf-8"))
for key in ("shell_environment_policy", "set"):
    values = values.get(key) if isinstance(values, dict) else None
values = values if isinstance(values, dict) else {}
print("\n".join(key for key, value in expected.items() if values.get(key) != value))
PYTHON
      fi 2>/dev/null
    ); then
      warn "$target cannot be read or parsed"
    elif [[ -z "$missing" ]]; then
      ok "$target sets both runtime cache variables"
    else
      for setting in "${settings[@]}"; do
        key=${setting%%=*}; value=${setting#*=}
        [[ $'\n'"$missing"$'\n' == *$'\n'"$key"$'\n'* ]] || continue
        if [[ "$file" == "$codex" ]]; then
          warn "$target: add $key = \"$value\""
        else
          warn "$target: add $setting"
        fi
      done
    fi
  done
}

echo "=== Environment ==="
if [[ -n "${ZSH_SETTINGS_DIR:-}" ]]; then
  ok "ZSH_SETTINGS_DIR=$ZSH_SETTINGS_DIR"
else
  # Check interactive zsh when the caller did not export ZSH_SETTINGS_DIR.
  zdir=$(have zsh && zsh -ic 'print -r -- ${ZSH_SETTINGS_DIR:-}' 2>/dev/null | tail -1)
  if [[ -n "$zdir" ]]; then
    ok "ZSH_SETTINGS_DIR=$zdir (interactive zsh)"
  else
    warn "ZSH_SETTINGS_DIR unset even in an interactive zsh — is init.zsh sourced from ~/.zshrc?"
  fi
fi

check_runtime_caches

echo
echo "=== Required tools ==="
# antidote is a zsh function (sourced from brew), not a PATH binary
check "antidote" test -f "$ANTIDOTE_SH"
for cmd in starship zoxide fzf eza bat fd rg gh glab git delta jaq xh pip; do
  check "$cmd" command -v "$cmd"
done

echo
echo "=== Optional tools ==="
for cmd in atuin direnv stow betterleaks shellcheck claude; do
  check "$cmd" command -v "$cmd"
done

echo
echo "=== Stow symlinks ==="
[[ -n $(stow_files) ]] || warn "no files tracked under home/ — is $REPO_ROOT a git clone?"
while IFS= read -r rel; do
  if [[ -L "$HOME/$rel" && "$HOME/$rel" -ef "$REPO_ROOT/home/$rel" ]]; then
    ok "$rel -> $(readlink "$HOME/$rel")"
  elif [[ "$HOME/$rel" -ef "$REPO_ROOT/home/$rel" ]]; then
    warn "$rel: its folder is a link into the repo — unfold it: stow --dir='$REPO_ROOT' --target='$HOME' --no-folding --restow home"
  elif [[ -L "$HOME/$rel" ]]; then
    warn "$rel: a link to $(readlink "$HOME/$rel"), not to this repo's file — re-run install.sh's Stow step"
  elif [[ -e "$HOME/$rel" ]]; then
    warn "$rel: real file (not Stow-managed)"
  else
    warn "$rel: missing"
  fi
done < <(stow_files)
untracked=$(git -C "$REPO_ROOT" ls-files -o -- home)
[[ -z $untracked ]] || { warn "untracked files under home/ — move them out of the public repo:"; printf '%s\n' "$untracked" | indent; }

echo
echo "=== Config symlinks + skhd ==="
# readlink-compare, not -L: a dangling or foreign-repo symlink must fail.
check "ghostty config -> repo" test "$(readlink "$HOME/.config/ghostty/config.ghostty" 2>/dev/null)" = "$REPO_ROOT/ghostty/config.ghostty"
check "skhdrc -> repo" test "$(readlink "$HOME/.config/skhd/skhdrc" 2>/dev/null)" = "$REPO_ROOT/skhd/skhdrc"
check "skhd running" pgrep -xq skhd

echo
echo "=== Fonts ==="
# Ghostty's configured font (ghostty/config.ghostty); cask font-jetbrains-mono
# and manual installs both land in ~/Library/Fonts.
if compgen -G "$HOME/Library/Fonts/JetBrainsMono*" > /dev/null; then
  ok "JetBrains Mono installed (Ghostty font)"
else
  warn "JetBrains Mono missing — Ghostty falls back (brew install --cask font-jetbrains-mono)"
fi
if [[ -s "$REPO_ROOT/docs/fonts.txt" ]]; then
  n=$(missing_fonts "$REPO_ROOT/docs/fonts.txt" "$HOME/Library/Fonts" | wc -l | tr -d ' ')
  if (( n == 0 )); then
    ok "all fonts from docs/fonts.txt present"
  else
    warn "$n fonts from docs/fonts.txt missing — restore manually from a backup"
  fi
fi

echo
echo "=== Repo state ==="
hp=$(hooks_path)
if [[ "$hp" == ".githooks" ]]; then
  ok "core.hooksPath = .githooks"
else
  warn "core.hooksPath = $hp — git -C '$REPO_ROOT' config core.hooksPath .githooks"
fi
if [[ ! -f "$REPO_ROOT/secrets.zsh" ]]; then
  warn "secrets.zsh missing (optional)"
# Verify what install.sh enforces: a hand copy can re-widen the perms.
elif [[ "$(stat -f %Lp "$REPO_ROOT/secrets.zsh")" == 600 ]]; then
  ok "secrets.zsh present (600)"
else
  warn "secrets.zsh perms are $(stat -f %Lp "$REPO_ROOT/secrets.zsh"), not 600 — chmod 600 secrets.zsh"
fi
check "docs/safari-favorites.txt" test -s "$REPO_ROOT/docs/safari-favorites.txt"
check "docs/secret-keys.txt" test -s "$REPO_ROOT/docs/secret-keys.txt"
if [[ -s "$REPO_ROOT/docs/secret-keys.txt" ]]; then
  missing_keys=$(grep -vE '^(#|$)' "$REPO_ROOT/docs/secret-keys.txt" | while IFS= read -r k; do
    # Invalid names never reach secrets.zsh (install.sh skips them with its
    # own warn), so reporting them as missing would point at a dead end.
    valid_key_name "$k" || continue
    grep -q "^export $k=" "$REPO_ROOT/secrets.zsh" 2>/dev/null || printf '%s\n' "$k"
  done)
  if [[ -z "$missing_keys" ]]; then
    ok "all docs/secret-keys.txt keys set in secrets.zsh"
  else
    warn "keys missing from secrets.zsh — run install.sh:"
    printf '%s\n' "$missing_keys" | indent
  fi
fi

echo
echo "=== Applied outcomes (macos.sh + docs/ snapshots) ==="
# minimal: one sentinel key stands in for the whole macos.sh run. Tap-to-click
# is what a machine that never ran it visibly misses first.
if [[ "$(defaults read com.apple.AppleMultitouchTrackpad Clicking 2>/dev/null)" == "1" ]]; then
  ok "tap-to-click enabled (macos.sh applied)"
else
  warn "tap-to-click off — run ./macos.sh, then log out/restart"
fi
# No second sentinel for the same macos.sh run: the desktop picture is the one
# macos.sh setting macOS itself keeps rewriting (a Photos wallpaper source swaps
# the file underneath), so it warned every day about a state that is fine.
# Stderr flows through on purpose: the script's own message (Full Disk Access,
# Safari never launched, corrupt plist) is the diagnosis, not a guess here.
if ! missing_favs=$("$REPO_ROOT/bin/safari-favorites" missing "$REPO_ROOT/docs/safari-favorites.txt"); then
  warn "cannot read Safari favorites (see message above)"
elif [[ -z "$missing_favs" ]]; then
  ok "all snapshot favorites present in Safari"
else
  warn "snapshot favorites missing from Safari — re-run install.sh:"
  printf '%s\n' "$missing_favs" | head -n 5 | indent
fi
# Dock is ordered (the layout IS the order); the sidebar is compared as a set.
# The snapshot side keeps only on-disk apps: the replay skips missing ones by
# design, so the check must promise no more than the replayer does.
if have dockutil && [[ -s "$REPO_ROOT/docs/dock.txt" ]]; then
  snap_dock=$(parse_dock "$REPO_ROOT/docs/dock.txt" | while IFS= read -r p; do
    [[ -e "$p" ]] && printf '%s\n' "$p"
  done)
  if [[ "$snap_dock" == "$(current_dock)" ]]; then
    ok "Dock matches docs/dock.txt"
  else
    warn "Dock drifted from docs/dock.txt — bench-export to keep it, install.sh to replay"
  fi
fi
if have mysides && [[ -s "$REPO_ROOT/docs/finder-sidebar.txt" ]]; then
  if [[ "$(parse_sidebar "$REPO_ROOT/docs/finder-sidebar.txt" | sort)" == "$(current_sidebar | sort)" ]]; then
    ok "Finder sidebar matches docs/finder-sidebar.txt"
  else
    warn "Finder sidebar drifted from docs/finder-sidebar.txt — bench-export to keep it, install.sh to replay"
  fi
fi

echo
echo "=== Default repos (docs/repos.txt) ==="
# Look up the clone by remote before recommending an install that could recreate an old path.
# True only when the host answered and denied the repo. An offline run fails the
# same call with "could not resolve host", and calling that dead would retire a
# good entry, so anything but an explicit denial falls through to install.sh.
# GIT_TERMINAL_PROMPT=0 because an unattended run must fail, never wait for input.
# A private repo whose credentials are missing also reads as gone; the Git auth
# section below reports missing credentials.
remote_gone() {
  local out
  out=$(GIT_TERMINAL_PROMPT=0 git ls-remote -- "$1" 2>&1 >/dev/null) && return 1
  printf '%s' "$out" | grep -qiE 'not found|does not exist|access denied|403|404'
}
if [[ -s "$REPO_ROOT/docs/repos.txt" ]]; then
  while read -r target url; do
    if [[ -d "$HOME/$target/.git" ]]; then
      ok "repo: $target"
    elif moved=$(find_clone "$url"); then
      if [[ "$moved" == *$'\n'* ]]; then
        warn "repo: $target — its remote is cloned more than once, so docs/repos.txt needs a hand-picked target:"
        printf '%s\n' "$moved" | indent
      else
        warn "repo: $target moved to $moved — bench-export to update docs/repos.txt"
      fi
    elif remote_gone "$url"; then
      warn "repo: $target missing and $url is gone — the docs/repos.txt entry is dead"
    else
      warn "repo: $target missing — run install.sh"
    fi
  done < <(parse_repos "$REPO_ROOT/docs/repos.txt")
else
  warn "docs/repos.txt missing/empty"
fi

echo
echo "=== IntelliJ JDK pins ==="
# The mise version-line symlink survives bench-update's prune of patch versions.
shopt -s nullglob
jdk_tables=("$HOME/Library/Application Support/JetBrains"/*/options/jdk.table.xml)
shopt -u nullglob
if (( ${#jdk_tables[@]} == 0 )); then
  skip "no IntelliJ jdk.table.xml"
else
  for t in "${jdk_tables[@]}"; do
    ide=$(basename "$(dirname "$(dirname "$t")")")
    jdk_status=$(python3 -B - "$REPO_ROOT/home/.config/mise/config.toml" "$t" 2>&1 <<'PYTHON'
import os
import sys
import tomllib
import xml.etree.ElementTree as ET
from pathlib import Path

config, table = map(Path, sys.argv[1:])
home = Path.home()

def expand_home(value):
    return value.replace("$USER_HOME$", str(home))

try:
    registrations = ET.parse(table).findall(".//jdk")
except (OSError, ET.ParseError):
    sys.exit("cannot read jdk.table.xml — check the SDKs in IntelliJ Project Structure")
sdks = {}
for sdk in registrations:
    name = sdk.find("./name[@value]")
    if name is None:
        continue
    locations = sdks.setdefault(name.get("value"), [])
    if sdk.find("./type[@value='JavaSDK']") is None:
        continue
    registered = sdk.find("./homePath")
    location = expand_home(registered.get("value", "")) if registered is not None else ""
    locations.append(location)

def check_configured_sdk():
    try:
        versions = tomllib.loads(config.read_text(encoding="utf-8"))["tools"]["java"]
    except (OSError, ValueError, KeyError):
        return "warn\tcannot read tools.java from the bench mise config — check home/.config/mise/config.toml"
    if isinstance(versions, str):
        versions = [versions]
    if not isinstance(versions, list) or not versions or not all(isinstance(v, str) and v for v in versions):
        return "warn\tinvalid tools.java in the bench mise config — set the Java version line"
    for version in versions:
        expected = home / ".local/share/mise/installs/java" / version
        if not (expected / "bin/java").is_file():
            return f"warn\t{expected} is missing its JDK — run mise install from your home directory"
        matching = sdks.get(version)
        if not matching:
            return f"warn\tadd the {version} SDK in IntelliJ Project Structure at {expected}"
        if any(location != str(expected) for location in matching):
            return f"warn\trepoint the {version} SDK in IntelliJ Project Structure to {expected}"
    return f"ok\t{', '.join(versions)} SDK resolves"

print(check_configured_sdk())
try:
    recent = ET.parse(table.with_name("recentProjects.xml"))
except (OSError, ET.ParseError):
    sys.exit(0)
unknown = []
for entry in recent.findall(".//entry[@key]"):
    project = Path(expand_home(entry.get("key")))
    if not project.is_absolute():
        continue
    try:
        settings = ET.parse(project / ".idea/misc.xml")
    except (OSError, ET.ParseError):
        continue
    for setting in settings.findall(".//*[@project-jdk-name]"):
        name = setting.get("project-jdk-name")
        if not name:
            continue
        label = f"{str(project).removeprefix(f'{home}/')} ({name})"
        if name not in sdks:
            unknown.append(label)
        else:
            for location in sdks[name]:
                sdk_home = Path(location)
                java = sdk_home / "bin/java"
                if not sdk_home.is_absolute() or not java.is_file() or not os.access(java, os.X_OK):
                    print(f"warn\t{label} has no executable bin/java — pick a project SDK in IntelliJ")
                    break
if unknown:
    print(f"warn\tprojects name SDKs it lacks: {' '.join(unknown)} — pick a project SDK in IntelliJ")
PYTHON
    ) || {
      warn "$ide: $jdk_status"
      continue
    }
    while IFS=$'\t' read -r level message; do
      case "$level" in
        ok) ok "$ide: $message" ;;
        warn) warn "$ide: $message" ;;
      esac
    done <<< "$jdk_status"
  done
fi

echo
echo "=== Git auth ==="
for tool in gh glab; do
  if "$tool" auth status >/dev/null 2>&1; then
    ok "$tool auth ok"
  else
    warn "$tool auth not configured"
  fi
done

echo
echo "=== Startup ==="
zsh -i -c exit >/dev/null 2>&1   # warm-up: absorb any stale-cache regeneration
# A clean interactive shell prints nothing on stderr; capture it so a silent
# startup error (like fzf's "can't change option: zle") surfaces as a warning.
startup_err=$(zsh -i -c exit 2>&1 >/dev/null)
if [[ -z "$startup_err" ]]; then
  ok "interactive startup clean (no stderr)"
else
  warn "interactive startup emits stderr:"
  printf '%s\n' "$startup_err" | indent
fi
# $EPOCHREALTIME is empty under bash 3.2 (macOS's /bin/bash). Guard it so a
# wrong interpreter reports honestly instead of a false 0ms.
if [[ -n "${EPOCHREALTIME:-}" ]]; then
  # Best of three: a single sample swings 40%+ with system load, and the minimum
  # is the least-contended figure, so the reported number stays reproducible.
  best=""
  for _ in 1 2 3; do
    # A comma-decimal locale writes a comma, which arithmetic reads as an operator.
    start=${EPOCHREALTIME//[.,]/}
    zsh -i -c exit >/dev/null 2>&1
    end=${EPOCHREALTIME//[.,]/}
    ms=$(( (end - start) / 1000 ))
    { [[ -z $best ]] || (( ms < best )); } && best=$ms
  done
  echo "  zsh -i -c exit took ${best}ms (best of 3)"
else
  warn "startup timing needs bash 5+ for \$EPOCHREALTIME (running $BASH_VERSION)"
fi
