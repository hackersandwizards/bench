#!/usr/bin/env bash
# List, plan or rewrite every reference to a folder before or after it moves.
# Usage: bench-paths <old>                 list references and live processes
#        bench-paths <old> <new>           print the rewrite plan
#        bench-paths --apply <old> <new>   rewrite what is safe now, list the rest
# The stores and why each is handled the way it is: docs/path-stores.md.
# Moving the folder stays with the caller, and --apply runs after it: a
# symlinked config resolves only once the link points at the moved tree.
set -uo pipefail

# shellcheck source-path=SCRIPTDIR
# shellcheck source=_lib.sh
. "$(dirname "$0")/_lib.sh"

apply=0
[[ ${1:-} == --apply ]] && { apply=1; shift; }
(( $# == 1 || $# == 2 )) || { echo "usage: bench-paths [--apply] <old> [<new>]" >&2; exit 2; }
# The logical $PWD, so /var stays /var where macOS links it to /private/var.
abspath() { python3 -I -c 'import os,sys; print(os.path.normpath(os.path.join(os.environ["PWD"], os.path.expanduser(sys.argv[1]))))' "$1"; }
old=$(abspath "$1"); new=${2:+$(abspath "$2")}
[[ $old == "$new" ]] && { echo "old and new are the same path" >&2; exit 2; }
(( apply )) && [[ -z $new ]] && { echo "--apply needs <new>" >&2; exit 2; }
(( apply )) && { [[ -e $new && ! -e $old ]] || { echo "--apply runs after the move: $new must exist and $old must not" >&2; exit 2; }; }

# Every spelling a store uses for the same folder, as O0..O$NK/N0..N$NK for perl.
# O5 is the transcript folder that Codex's import ledger names; the projects
# step below adds one pair per subfolder project from O6 on.
enc() { printf '%s' "$1" | sed 's/[^A-Za-z0-9]/-/g'; }
O5="/.claude/projects/$(enc "$old")/" N5="/.claude/projects/$(enc "$new")/" NK=5
export O0="$old" N0="$new" O5 N5 NK
if [[ $old == "$HOME"/* ]]; then
  rel=${old#"$HOME"/} nrel=${new#"$HOME"/}
  [[ $new == "$HOME"/* ]] || nrel=""
  i=1
  # shellcheck disable=SC2088,SC2016  # literal spellings, never expanded
  for pre in '~/' '$HOME/' '${HOME}/' '$USER_HOME$/'; do
    export "O$i=$pre$rel"
    # A new path outside $HOME has no relative spelling: write it absolute.
    if [[ -n $nrel ]]; then export "N$i=$pre$nrel"; else export "N$i=$new"; fi
    i=$((i + 1))
  done
fi
# A match ends where the path does: /opt/x must not hit /opt/x-old or
# /opt/x.bak, while a sentence's closing dot still ends it.
# shellcheck disable=SC2016  # perl code
PL='BEGIN { @f = map { my $o = $ENV{"O$_"}; [$o =~ m{/$} ? qr/\Q$o\E/ : qr/\Q$o\E(?![\w-]|\.\w)/, $ENV{"N$_"}] } grep { defined $ENV{"O$_"} } 0..$ENV{NK} }'
count_refs() { perl -ne "$PL"' my $l = $_; $c += () = $l =~ /$_->[0]/g for @f; END { print $c + 0 }' "$1"; }
rewrite_file() { perl -i.bench-paths-bak -pe "$PL"' for my $x (@f) { my $n = $x->[1]; s/$x->[0]/$n/g }' "$1"; }
pats() { local i v; for ((i = 0; i <= NK; i++)); do v="O$i"; [[ -n ${!v:-} ]] && printf '%s\n' "${!v}"; done; }

running() {  # running "a,b": the first of these process names that runs
  local n; IFS=, read -ra names <<< "$1"
  for n in "${names[@]}"; do
    if [[ $n == claude ]]; then [[ $claudes == *[0-9]* ]] || continue
    else pgrep -x "$n" >/dev/null 2>&1 || continue; fi
    printf '%s' "$n"; return 0
  done
  return 1
}
inside() { [[ $1 == "$old" || $1 == "$old"/* ]]; }
moved() { printf '%s' "$new${1#"$old"}"; }
say() { printf '  %-9s %s\n' "$1" "$2"; }
manual=()

# A process that sat in old when it moved now reports the new path. lsof runs
# from / so neither it nor this script's subshells count as processes inside
# the folder.
step "Processes with a working directory inside $old${new:+ or $new}"
live=0 nproc=0
# ps, not pgrep: pgrep leaves out its own ancestors, so a run from inside a
# Claude Code session would miss that session.
claudes=" $(ps -axo pid=,comm= | awk '$2 ~ /(^|\/)claude$/ {printf "%s ", $1}') "
cwds=$(cd / && lsof -d cwd -Fpcn 2>/dev/null | awk '/^p/{p=substr($0,2)} /^c/{c=substr($0,2)} /^n/{print p "\t" c "\t" substr($0,2)}')
while IFS=$'\t' read -r pid cmd dir; do
  [[ $pid == "$$" ]] && continue
  inside "$dir" || { [[ -n $new ]] && [[ $dir == "$new" || $dir == "$new"/* ]]; } || continue
  nproc=1
  if [[ $claudes == *" $pid "* ]]; then live=1; say "$pid" "Claude Code session  $dir"; else say "$pid" "$cmd  $dir"; fi
done <<< "$cwds"
(( live )) && manual+=("close the Claude Code sessions listed under Processes, then rerun with --apply: they keep writing to the old project folder")
(( nproc )) || say "none" ""

step "Claude Code projects (~/.claude/projects/<encoded path>)"
projects="$HOME/.claude/projects"
e=$(enc "$old")
for d in "$projects/$e" "$projects/$e"-*; do
  [[ -d $d ]] || continue
  cwd=$(rg -m1 -o -N --no-filename '"cwd":"[^"]*"' "$d" -g '*.jsonl' 2>/dev/null | head -1 | sed 's/^"cwd":"//; s/"$//')
  if [[ -z $cwd ]]; then
    [[ $d == "$projects/$e" ]] || { say "check" "${d#"$projects"/} (no transcript names its folder)"; continue; }
    cwd=$old
  fi
  inside "$cwd" || continue
  # enc cannot tell old/sub from old-sub, so a subfolder's spelling comes from its transcript.
  if [[ $d != "$projects/$e" ]]; then
    NK=$((NK + 1)); export "O$NK=/.claude/projects/${d#"$projects"/}/"
    [[ -z $new ]] || export "N$NK=/.claude/projects/$(enc "$(moved "$cwd")")/"
  fi
  if [[ -z $new ]]; then say "found" "${d#"$projects"/}"; continue; fi
  target="$projects/$(enc "$(moved "$cwd")")"
  if [[ -e $target ]]; then manual+=("merge $d into existing $target by hand")
  elif (( live )); then manual+=("mv '$d' '$target' (after the listed sessions close)")
  elif (( apply )); then mv "$d" "$target" && say "renamed" "${d#"$projects"/} -> ${target#"$projects"/}"
  else say "rename" "${d#"$projects"/} -> ${target#"$projects"/}"; fi
done

step "Symlinks pointing into $old"
while IFS=$'\t' read -r l t abs; do
  inside "$abs" || continue
  if [[ -z $new ]]; then say "found" "$l -> $t"; continue; fi
  nt=$(moved "$abs")
  [[ $t == /* ]] || nt=$(python3 -I -c 'import os,sys; print(os.path.relpath(sys.argv[1], sys.argv[2]))' "$nt" "$(dirname "$l")")
  if (( apply )); then ln -sfn "$nt" "$l" && say "relinked" "$l -> $nt"; else say "relink" "$l -> $nt"; fi
done < <(
  { find "$HOME" -maxdepth 3 \( -path "$HOME/Library" -o -path "$HOME/dev" -o -path "$HOME/opt" \) -prune -o -type l -print
    find "$projects" "$HOME/.claude-swap-backup/sessions" -mindepth 2 -maxdepth 2 -type l
  } 2>/dev/null | python3 -I -c '
import os, sys
for l in sys.stdin.read().splitlines():
    t = os.readlink(l)
    print(l, t, os.path.normpath(os.path.join(os.path.dirname(l), t)), sep="\t")'
)
for f in "$HOME"/.local/state/mise/trusted-configs/*; do
  [[ -L $f ]] || continue
  c=$(readlink "$f"); inside "$c" || continue
  if [[ -z $new ]]; then say "mise" "trusted: $c"; else manual+=("mise trust '$(moved "$c")'"); fi
done

# Store table: kind|apps that must be quit|path|rg glob. text rewrites in
# place; sqlite rewrites the named table.column list; launchd is text plus a
# reload; zoxide goes through its CLI; source is a copy whose source must
# change; binary is listed only.
AS="$HOME/Library/Application Support"
stores() {
  cat <<EOF
text|claude|$HOME/.claude.json|
text|claude|$HOME/.claude-swap-backup/configs|*.json
text||$HOME/.claude/plugins/known_marketplaces.json|
text||$HOME/.claude/plugins/installed_plugins.json|
text||$HOME/.claude/scheduled-tasks|*.md
source||$HOME/.claude/rules|
source||$HOME/.claude/skills|
source||$HOME/.claude/agents|
source||$HOME/.claude/scripts|
text|Claude|$AS/Claude|{claude_desktop_config,git-worktrees,ccd-session-presets,remote-control-state}.json
text|Claude|$AS/Claude/claude-code-sessions|*.json
text|Claude|$AS/Claude/local-agent-mode-sessions|*.json
binary|Claude|$AS/Claude/Local Storage|
binary|Claude|$AS/Claude/IndexedDB|
binary|Claude|$AS/Claude/git-shadow|
text|codex,Codex|$HOME/.codex|{config.toml,.codex-global-state.json,external_agent_session_imports.json}
sqlite|codex,Codex|$HOME/.codex|state_*.sqlite threads.cwd project_roots.path
sqlite|codex,Codex|$HOME/.codex/sqlite|codex-dev.db local_thread_catalog.cwd
text|idea,jetbrains-toolbox|$AS/JetBrains|{*.xml,db.json,session-identities.json}
sqlite|zed|$AS/Zed/db|*/db.sqlite workspaces.paths workspaces.identity_paths trusted_worktrees.absolute_path sidebar_threads.folder_paths sidebar_threads.main_worktree_paths editors.buffer_path kv_store.value
text|opencode|$HOME/.local/share/opencode/storage/project|*.json
text|opencode|$HOME/.local/share/opencode/storage/session|*.json
sqlite|opencode|$HOME/.local/share/opencode|opencode.db project.worktree project.sandboxes session.directory project_directory.directory
text|Antigravity|$HOME/.gemini/projects.json|
text|Antigravity|$HOME/.gemini/trustedFolders.json|
text|Antigravity|$HOME/.gemini/antigravity-cli/settings.json|
text|Antigravity|$HOME/.gemini/antigravity-cli/cache/projects.json|
text|Antigravity|$HOME/.gemini/config/projects|*.json
binary|t3code|$AS/t3code-v2/IndexedDB|
text||$AS/rtk/trusted_filters.json|
text||$HOME/.config|!**/gcloud/**
text||$HOME/.zshrc|
text||$HOME/.zshenv|
text||$HOME/.zprofile|
sqlite||$HOME/.local/share/atuin|history.db history.cwd
zoxide||${_ZO_DATA_DIR:-$AS/zoxide}/db.zo|
launchd||$HOME/Library/LaunchAgents|*.plist
EOF
}

# Counts or rewrites the given table.column list with the same end-of-path
# rule as the perl above. argv: count|apply db old new table.column...
SQLPY=$(cat <<'PY'
import os, re, sqlite3, sys
mode, db, old, new, *cols = sys.argv[1:]
rx = re.compile(re.escape(old) + r"(?![\w-]|\.\w)")
if mode == "apply":
    con = sqlite3.connect(db)
else:
    try:
        con = sqlite3.connect(f"file:{db}?mode=ro", uri=True)
        con.execute("select 1 from sqlite_master")
    except sqlite3.Error:  # some live WAL databases refuse mode=ro: count the main file, WAL rows unseen
        con = sqlite3.connect(f"file:{db}?immutable=1", uri=True)
con.create_function("bp", 1, lambda s: rx.sub(lambda _: new, s) if isinstance(s, str) else s)
have = {(t, c) for (t,) in con.execute("select name from sqlite_master where type='table'")
        for (c,) in con.execute(f'select name from pragma_table_info("{t}")')}
if mode == "apply":
    os.umask(0o077)  # a backup of a private database stays private, even while it is written
    con.backup(sqlite3.connect(db + ".bench-paths-bak"))
total = 0
for tc in cols:
    t, c = tc.split(".")
    if (t, c) not in have:
        continue
    if mode == "count":
        total += sum(len(rx.findall(v)) for (v,) in con.execute(f'select "{c}" from "{t}" where instr("{c}", ?)', (old,)) if isinstance(v, str))
    else:
        total += con.execute(f'update "{t}" set "{c}" = bp("{c}") where instr("{c}", ?)', (old,)).rowcount
con.commit()
print(total)
PY
)

# zoxide entries inside old, as "<score> <path>", from the $zo_rows the store
# loop read with one query.
zo_inside() {
  local s p
  while read -r s p; do
    inside "$p" && printf '%s %s\n' "$s" "$p"
  done <<< "$zo_rows"
}
# The CLI exposes frecency, not rank, and add stamps now: a quarter of the
# score matches the old score at this moment only.
rewrite_zoxide() {
  local rows r p t
  rows=$(zo_inside)
  cp "$1" "$1.bench-paths-bak" || return 1
  while read -r r p; do
    t=$(moved "$p")
    if [[ -d $t ]]; then zoxide add -s "$(awk -v r="$r" 'BEGIN { print r / 4 }')" "$t" || return 1
    else say "dropped" "$p"; fi
    zoxide remove "$p" || return 1
  done <<< "$rows"
}

step "Stores"
pf=$(mktemp); trap 'rm -f "$pf"' EXIT
pats > "$pf"
while IFS='|' read -r kind apps path glob; do
  [[ -e $path ]] || continue
  if [[ $kind == sqlite ]]; then
    read -r dbglob cols <<< "$glob"
    # shellcheck disable=SC2086  # dbglob is a glob by design
    files=$(shopt -s nullglob; printf '%s\n' "$path"/$dbglob)
  elif [[ $kind == zoxide ]]; then
    zo_rows=$(zoxide query --list --all --score 2>&1) || { warn "zoxide cannot read $path: $zo_rows"; continue; }
    files=$path
  else
    # -L: Stow links configs under ~/.config into a repo; rg skips links otherwise.
    args=(-l -L -F -f "$pf" --hidden --no-ignore --max-filesize 50M -g '!*.bench-paths-bak' "$path")
    [[ $kind == binary ]] && args=(-a "${args[@]}")
    [[ -n $glob ]] && args+=(-g "$glob")
    files=$(rg "${args[@]}" 2>/dev/null)
  fi
  [[ -n $files ]] || continue
  # One store, one action: the kind and the gating app decide it for every file.
  act=rewrite
  if [[ -z $new ]]; then act=list
  elif [[ $kind == source ]]; then act=manual; why="a copy: change the source it is synced from, then sync"
  elif [[ $kind == binary ]]; then act=manual; why="app-internal state, not rewritten: open the folder in $apps after the move and check it"
  elif [[ -n $apps ]] && busy=$(running "$apps"); then act=manual; why="quit every $busy process, then rerun with --apply"
  fi
  nf=0 nr=0
  while IFS= read -r f; do
    if [[ $kind == sqlite ]]; then
      # shellcheck disable=SC2086  # cols is a word list by design
      n=$(python3 -I -c "$SQLPY" count "$f" "$old" "" $cols)
    elif [[ $kind == zoxide ]]; then
      n=$(zo_inside | grep -c '')
      # Before the move a folder sits at old, after it at new; at neither it is dropped.
      if [[ -n $new ]] && (( !apply )); then
        while read -r _ p; do [[ -d $p || -d $(moved "$p") ]] || say "drop" "$p"; done < <(zo_inside)
      fi
    else n=$(count_refs "$f"); fi
    (( n )) || [[ $kind == binary ]] || continue
    nf=$((nf + 1)) nr=$((nr + n))
    if [[ $act == rewrite ]] && (( apply )); then
      real=$(realpath "$f")
      # shellcheck disable=SC2086
      if [[ $kind == sqlite ]]; then python3 -I -c "$SQLPY" apply "$real" "$old" "$new" $cols >/dev/null
      elif [[ $kind == zoxide ]]; then rewrite_zoxide "$real"
      else rewrite_file "$real"; fi || warn "rewrite failed: $f"
    fi
  done <<< "$files"
  (( nf )) || continue
  where=$path; [[ -n $glob ]] && where="$path [$glob]"
  label="$where: $nf file(s), $nr ref(s)"; [[ $kind == binary ]] && label="$where: $nf file(s)"
  case $act in
    list)    say "$kind" "$label${apps:+  (app: $apps)}" ;;
    manual)  manual+=("$label — $why") ;;
    rewrite) if (( apply )); then say "rewrote" "$label"; else say "rewrite" "$label"; fi ;;
  esac
  [[ $act == rewrite && $kind == launchd ]] && manual+=("reload each rewritten agent under $path: launchctl bootout gui/$UID <plist>; launchctl bootstrap gui/$UID <plist>")
done < <(stores)

step "Git worktrees (absolute links between a repo and its worktrees)"
tree=$old; [[ -d $tree || -z $new ]] || tree=$new
while IFS= read -r g; do
  repo=$(dirname "$g")
  # A submodule's .git file points relative and moves with it; a worktree's is absolute.
  if [[ -f $g ]]; then grep -q '^gitdir: /.*/worktrees/' "$g" || continue
  else [[ -n $(ls -A "$g/worktrees" 2>/dev/null) ]] || continue; fi
  if [[ -z $new ]]; then say "found" "$repo"; continue; fi
  [[ $tree == "$old" ]] && repo=$(moved "$repo")
  manual+=("after the move: git -C '$repo' worktree repair")
done < <([[ -d $tree ]] && find "$tree" -maxdepth 6 -name node_modules -prune -o -name .git -print 2>/dev/null)

step "Containers with a mount inside $old"
if have docker && ids=$(docker ps -aq 2>/dev/null) && [[ -n $ids ]]; then
  # shellcheck disable=SC2086
  while read -r name srcs; do
    for s in $srcs; do inside "$s" || continue; say "mount" "$name $s"; manual+=("recreate container $name: its mount $s keeps the old source"); done
  done < <(docker inspect -f '{{.Name}}{{range .Mounts}} {{.Source}}{{end}}' $ids 2>/dev/null)
fi

step "Files in other repositories under ~/dev and ~/opt (their owners change them)"
rg -l -F -f "$pf" "$HOME/dev" "$HOME/opt" --hidden --max-filesize 1M -g '!**/node_modules/**' -g '!.git' 2>/dev/null \
  | while IFS= read -r f; do inside "$f" || [[ -n $new && ( $f == "$new" || $f == "$new"/* ) ]] || say "repo" "$f"; done

if [[ -n $new ]]; then
  step "Manual steps"
  if ((${#manual[@]})); then printf '  - %s\n' "${manual[@]}"; else say "none" ""; fi
fi
