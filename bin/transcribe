#!/usr/bin/env bash
set -euo pipefail

MODEL="$HOME/.t3/userdata/speech/models/parakeet-ultra-Q8_0.gguf"

usage() {
  echo "usage: transcribe [-o outdir] file..."
  echo "  -o outdir  write there instead of next to each input"
}

out=""
while getopts o:h opt; do
  case $opt in
    o) out=$OPTARG ;;
    h) usage; exit 0 ;;
    *) usage >&2; exit 2 ;;
  esac
done
shift $((OPTIND - 1))
(($#)) || { usage >&2; exit 2; }

if [[ ! -f $MODEL ]]; then
  echo "transcribe: model missing at $MODEL. Download Parakeet Ultra in T3 Code's speech settings." >&2
  exit 1
fi

# Each output is <dir>/<name>, the extension taken off the file name, never off
# a dotted folder. Checked before the first run, resolved and case-folded as APFS
# compares names: two inputs writing one output keep only the last.
outs=() seen=$'\n'
for f; do
  [[ -f $f ]] || { echo "transcribe: no such file: $f" >&2; exit 1; }
  b=$(basename "$f"); o="${out:-$(dirname "$f")}/${b%.*}"
  d=$(cd "${o%/*}" 2>/dev/null && pwd -P) || d=${o%/*}
  k=$(printf '%s/%s' "$d" "${o##*/}" | tr '[:upper:]' '[:lower:]')
  [[ $seen != *$'\n'"$k"$'\n'* ]] || { echo "transcribe: two inputs would write $o.txt" >&2; exit 1; }
  seen+="$k"$'\n' outs+=("$o")
done

tmp=""
trap '[[ -z $tmp ]] || rm -rf "$tmp"' EXIT
i=0
for f; do
  o=${outs[i]}; i=$((i + 1))
  mkdir -p "${o%/*}"
  tmp=$(mktemp -d)
  src="$tmp/audio.wav"
  ffmpeg -nostdin -loglevel error -y -i "$f" -vn -ac 1 -ar 16000 -c:a pcm_s16le "$src"
  uv run --no-project --with transcribe-cpp==0.5.0 python - "$MODEL" "$src" "$o" >/dev/null <<'PY'
from array import array
from pathlib import Path
import sys
import wave

from transcribe_cpp import Model


def word_cues(words):
    cue = []
    for word in words:
        if cue and word.t1_ms - cue[0].t0_ms > 10_000:
            yield cue
            cue = []
        cue.append(word)
        if word.text.rstrip().rstrip('”’"»)]}').endswith((".", "?", "!", "…")):
            yield cue
            cue = []
    if cue:
        yield cue


def srt_time(ms):
    seconds, millis = divmod(ms, 1000)
    minutes, seconds = divmod(seconds, 60)
    hours, minutes = divmod(minutes, 60)
    return f"{hours:02}:{minutes:02}:{seconds:02},{millis:03}"


model_path, wav_path, output_base = sys.argv[1:]
with wave.open(wav_path, "rb") as audio:
    samples = array("h", audio.readframes(audio.getnframes()))
pcm = array("f", (sample / 32768 for sample in samples))
with Model(model_path) as model, model.session() as session:
    result = session.run(pcm, timestamps="word")

Path(output_base + ".txt").write_text(result.text + "\n", encoding="utf-8")
with open(output_base + ".srt", "w", encoding="utf-8") as subtitles:
    end = 0
    for number, cue in enumerate(word_cues(result.words), 1):
        start = max(end, cue[0].t0_ms)
        end = max(start + 1, cue[-1].t1_ms)
        text = " ".join(word.text.strip() for word in cue)
        subtitles.write(f"{number}\n{srt_time(start)} --> {srt_time(end)}\n{text}\n\n")
PY
  rm -rf "$tmp"
  tmp=""
  printf '%s\n' "$o.txt" "$o.srt"
done
