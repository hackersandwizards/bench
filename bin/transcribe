#!/usr/bin/env bash
# Speech to text with whisper.cpp: writes <name>.txt and <name>.srt (segment
# timestamps) per input. The one supported transcription path on this bench.
# README "Transcription" has the measurements behind the fixed flags.
set -euo pipefail

MODEL="$HOME/.cache/whisper/ggml-large-v3-turbo.bin"
MODEL_URL="https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-large-v3-turbo.bin"

usage() {
  echo "usage: transcribe [-l lang] [-o outdir] file..."
  echo "  -l lang    spoken language, default en. en and de are measured (README \"Transcription\")."
  echo "  -o outdir  write there instead of next to each input"
  echo "  flac, mp3, ogg and wav go to whisper-cli as they are; anything else"
  echo "  (mp4, m4a, mov, ...) is converted with ffmpeg first."
}

lang=en out=""
while getopts l:o:h opt; do
  case $opt in
    l) lang=$OPTARG ;;
    o) out=$OPTARG ;;
    h) usage; exit 0 ;;
    *) usage >&2; exit 2 ;;
  esac
done
shift $((OPTIND - 1))
(($#)) || { usage >&2; exit 2; }

if [[ ! -f $MODEL ]]; then
  echo "transcribe: model missing: $MODEL (1.6 GB). Fetch it with:" >&2
  echo "  curl -fL --create-dirs -o \"$MODEL\" \"$MODEL_URL\"" >&2
  exit 1
fi

# Each output is <dir>/<name>, the extension taken off the file name, never off
# a dotted folder. Checked before the first run, resolved and case-folded as APFS
# compares names: two inputs writing one output keep only the last.
outs=() seen=$'\n'
for f; do
  [[ -f $f ]] || { echo "transcribe: no such file: $f" >&2; exit 1; }
  b=$(basename "$f"); o="${out:-$(dirname "$f")}/${b%.*}"
  d=$(cd "${o%/*}" 2>/dev/null && pwd -P) || d=${o%/*}
  k=$(printf '%s/%s' "$d" "${o##*/}" | tr '[:upper:]' '[:lower:]')
  [[ $seen != *$'\n'"$k"$'\n'* ]] || { echo "transcribe: two inputs would write $o.txt" >&2; exit 1; }
  seen+="$k"$'\n' outs+=("$o")
done

# set -e leaves the loop on a failed ffmpeg or whisper-cli; the trap still drops
# the converted WAV, which runs to about 115 MB per hour of audio.
tmp=""
trap '[[ -z $tmp ]] || rm -rf "$tmp"' EXIT
i=0
for f; do
  o=${outs[i]}; i=$((i + 1))
  mkdir -p "${o%/*}"
  src=$f
  case $(printf '%s' "${f##*.}" | tr '[:upper:]' '[:lower:]') in
    flac | mp3 | ogg | wav) ;;
    *)
      tmp=$(mktemp -d)
      src="$tmp/${o##*/}.wav"
      ffmpeg -nostdin -loglevel error -y -i "$f" -vn -ac 1 -ar 16000 -c:a pcm_s16le "$src"
      ;;
  esac
  # -mc 0 is the reason this wrapper exists (README "Transcription"), and
  # bench-test fails if the flag goes missing.
  whisper-cli -m "$MODEL" -l "$lang" -mc 0 -f "$src" -otxt -osrt -of "$o" -np >/dev/null
  [[ -z $tmp ]] || rm -rf "$tmp"
  tmp=""
  printf '%s\n' "$o.txt" "$o.srt"
done
