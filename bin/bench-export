#!/usr/bin/env bash
# Check the Brewfile, refresh docs/ inventories, and sync home/ from $HOME.
set -u

# shellcheck source-path=SCRIPTDIR
# shellcheck source=_lib.sh
. "$(dirname "$0")/_lib.sh"

DOCS="$REPO_ROOT/docs"
HOME_DIR="$REPO_ROOT/home"

mkdir -p "$DOCS"

# Overwrite the destination only on success: a failed command leaves the
# previous snapshot intact (no empty files). On failure the captured stderr is
# shown; some dumpers (safari-favorites) put the remediation there, and a bare
# "failed" would hide it.
dump_to() {
  local out="$1"; shift
  local tmp="$out.tmp"
  if "$@" > "$tmp" 2>"$tmp.err"; then
    mv "$tmp" "$out"
    ok "${out##*/}"
  else
    rm -f "$tmp"
    warn "${out##*/} failed"
    [[ -s "$tmp.err" ]] && tail -n 3 "$tmp.err" | indent
  fi
  rm -f "$tmp.err"
}

# --- Brewfile drift check (never auto-overwrite: cask/mas entries are aspirational
# fresh-install targets, not always present locally; `brew bundle dump --force`
# would silently delete them). Report missing leaves and casks to add by hand.
# leaves feeds the docs/brew-leaves.txt dump below too, so brew leaves runs once.
leaves=""
have brew && step "Brewfile drift"
if brew_ready; then
  if leaves=$(brew leaves) && casks=$(brew list --cask); then
    # Brewfile names a tap's formula or cask in full; brew lists it by its last part.
    declared() { awk -F'"' -v k="$1" '$0 ~ "^" k " " { n = $2; sub(/.*\//, "", n); print n }' "$REPO_ROOT/Brewfile" | sort -u; }
    missing="$(comm -23 <(awk -F/ '{ print $NF }' <<<"$leaves" | sort -u) <(declared brew))"
    missing_casks="$(comm -23 <(sort -u <<<"$casks") <(declared cask))"
    if [[ -z "$missing$missing_casks" ]]; then
      ok "Brewfile in sync with brew leaves and casks"
    else
      warn "Installed leaves and casks missing from Brewfile — add by hand:"
      printf '%s\n' "$missing" "$missing_casks" | grep . | indent
    fi
  else
    # A failed brew leaves may have printed part of the list: never snapshot it.
    leaves=""
    warn "brew leaves or brew list --cask failed — Brewfile drift not checked, brew snapshots kept"
  fi
fi

# Each tool is its own subprocess and stat-bound: fan out, then `wait`.
step "docs/ snapshots"
if [[ -n $leaves ]]; then   # set only when brew answered above
  dump_to "$DOCS/brew-taps.txt"   brew tap    &
  dump_to "$DOCS/brew-leaves.txt" printf '%s\n' "$leaves" &
  dump_to "$DOCS/brews.txt"       brew list   &
fi
# pipefail inside each *_dump: a failing producer must fail dump_to, not hand sed
# an empty stream that overwrites the snapshot. Each runs in its own & subshell.
bun_globals_dump() { set -o pipefail; bun pm -g list | sed "s|$HOME|\$HOME|g"; }
have bun   && dump_to "$DOCS/buns.txt"  bun_globals_dump           &
have pip   && dump_to "$DOCS/pip.txt"   pip_managed_freeze         &
# --no-unicode: npm picks tree glyphs by TTY, so an interactive export and this
# unattended one would rewrite the same file back and forth forever.
have npm   && dump_to "$DOCS/npms.txt"  npm list -g --depth=0 --no-unicode &
dump_to "$DOCS/safari-favorites.txt" "$REPO_ROOT/bin/safari-favorites" export &
# $HOME -> literal token so the snapshots replay for any user (parse_* expands it).
# grep .: an empty list with exit 0 fails too, since the replay refuses an empty snapshot.
dock_dump()    { set -o pipefail; dockutil --list | sed "s|$HOME|\$HOME|g" | grep .; }
sidebar_dump() { set -o pipefail; mysides list    | sed "s|$HOME|\$HOME|g" | grep .; }
have dockutil && dump_to "$DOCS/dock.txt"           dock_dump    &
have mysides  && dump_to "$DOCS/finder-sidebar.txt" sidebar_dump &
# A domain with no prefs exports an empty dict with exit 0: keep the snapshot.
moom_dump() { local p; p=$(defaults export com.manytricks.Moom -) && [[ $p == *'<key>'* ]] && printf '%s\n' "$p"; }
have defaults && dump_to "$DOCS/moom.plist" moom_dump &
wait
# Never dump ~/.gradle/gradle.properties here: it holds signing/Sonatype
# credentials and this repo is public (leaked once, 2026-07).
# fonts.txt is a union checklist, not a state snapshot (same rule as the
# Brewfile drift check above): a fresh machine's sparse ~/Library/Fonts must
# never erase the old machine's manual-restore list. Merge, don't overwrite;
# prune entries by hand.
# shellcheck disable=SC2012
if { [[ -s "$DOCS/fonts.txt" ]] && cat "$DOCS/fonts.txt"; ls "$HOME/Library/Fonts"; } 2>/dev/null \
     | LC_ALL=C sort -u > "$DOCS/fonts.txt.tmp" && [[ -s "$DOCS/fonts.txt.tmp" ]]; then
  mv "$DOCS/fonts.txt.tmp" "$DOCS/fonts.txt"
  ok "fonts.txt (union)"
else
  rm -f "$DOCS/fonts.txt.tmp"
  warn "fonts.txt failed"
fi

# Only one thing in docs/repos.txt is a choice: which repos a fresh machine gets.
# Where each one sits and what its host calls it are facts of this machine, and a
# reorg or a rename leaves the entry describing a layout that is gone — install.sh
# would rebuild the old one. So correct located entries and never touch the
# selection: nothing is added, nothing is removed, and an entry whose clone is
# nowhere is left alone and named here; doctor tells an uncloned one from a dead one.
step "docs/repos.txt (paths and renames follow the machine)"
if [[ -s "$DOCS/repos.txt" ]] && have fd; then
  stale=0
  # Read the entries out before the first rewrite: the loop truncates the file
  # a process substitution would still be streaming from.
  entries=$(parse_repos "$DOCS/repos.txt")
  while read -r target url; do
    [[ -d "$HOME/$target/.git" ]] && continue
    stale=1
    moved=$(find_clone "$url") || {
      warn "repos.txt: $target ($url) has no clone under ~/dev or ~/opt — bench-doctor says whether it is dead"
      continue
    }
    if [[ "$moved" == *$'\n'* ]]; then
      warn "repos.txt: $url is cloned more than once — pick one by hand:"
      printf '%s\n' "$moved" | indent
      continue
    fi
    now="https://$(repo_slug "$(git -C "$HOME/$moved" remote get-url origin 2>/dev/null)").git"
    if repos_repoint "$DOCS/repos.txt" "$target" "$url" "$moved" "$now"; then
      if [[ "$now" == "$url" ]]; then ok "repos.txt: $target -> $moved"
      else ok "repos.txt: $target -> $moved (renamed to $now)"; fi
    else
      warn "repos.txt: could not rewrite the entry for $target — fix it by hand"
    fi
  done <<<"$entries"
  (( stale )) || ok "repos.txt: every entry points at its clone"
else
  skip "repos.txt: empty or fd missing, entries not checked"
fi

step "home/ sync (Symlinks → skip, real files → copy back)"
while IFS= read -r rel; do
  src="$HOME/$rel"
  dst="$HOME_DIR/$rel"
  if [[ ! -e "$src" ]]; then
    warn "$rel: not in \$HOME, skipping"
    continue
  fi
  if [[ -L "$src" ]]; then
    continue
  fi
  # It can name client hosts, and no secret scan flags a host name.
  if [[ $rel == .ssh/config ]]; then
    cmp -s "$src" "$dst" || warn "$rel: a real file that differs from home/ — not copied into this public repo; diff it and copy by hand"
    continue
  fi
  mkdir -p "$(dirname "$dst")"
  if [[ -f "$dst" ]] && cmp -s "$src" "$dst"; then
    ok "$rel: identical"
  else
    cp "$src" "$dst" && ok "$rel: copied"
  fi
done < <(stow_files)

step "Done"
