#!/usr/bin/env bash
# Reclaim disk: purge regenerable caches, drop superseded JetBrains
# versions, sweep .DS_Store, remove finished Claude Code session temp folders.
# --dry-run reports the temp-folder sweep and does nothing else.
# Removes only auto-regenerating caches, superseded files and finished sessions' temp folders, never
# installed tools.
set -u

# shellcheck source-path=SCRIPTDIR
# shellcheck source=_lib.sh
. "$(dirname "$0")/_lib.sh"

# Removes a session's folder only when every signal says finished; any signal it cannot read
# stops the whole run, so a broken check keeps files and shows up as a warn.
sweep_cc_tmp() {  # sweep_cc_tmp [--dry-run]
  local dry="${1:-}" days=14 root base="$HOME/Library/Caches/claude-code-tmp"
  local rec line pid start sid now running live="|" pids="|" open
  root="$base/claude-$UID"
  [[ -d "$root" ]] || { skip "Claude temp: no folder yet"; return 0; }
  [[ ! -L "$base" && ! -L "$root" ]] || { warn "Claude temp: $root is a symlink, nothing swept"; return 0; }
  have jaq || { warn "Claude temp: jaq missing, nothing swept"; return 0; }
  root=$(cd "$root" && pwd -P) || { warn "Claude temp: cannot enter $root, nothing swept"; return 0; }

  # Before the record scan, so a claude started during the scan cannot look unrecorded. Without -a,
  # macOS pgrep leaves out its own ancestors, the session running this among them.
  running=$(pgrep -ax claude); (( $? <= 1 )) || { warn "Claude temp: pgrep failed, nothing swept"; return 0; }

  # Accounts other than the default keep their records under cswap's config dirs.
  for rec in "$HOME"/.claude/sessions/*.json "$HOME"/.claude-swap-backup/sessions/*/sessions/*.json; do
    [[ -f "$rec" ]] || continue
    line=$(jaq -r '[.pid, .procStart, .sessionId] | @tsv' "$rec" 2>/dev/null)
    IFS=$'\t' read -r pid start sid <<<"$line"
    if ! [[ "$pid" =~ ^[0-9]+$ && -n "$start" && -n "$sid" ]]; then
      [[ -e "$rec" ]] || continue  # its process ended while this loop ran
      warn "Claude temp: unreadable record $rec, nothing swept"; return 0
    fi
    # procStart is in UTC; a differing start time means the pid now belongs to another process.
    now=$(TZ=UTC LC_ALL=C ps -o lstart= -p "$pid" 2>/dev/null)
    [[ -n "$now" && "${now// /}" == "${start// /}" ]] || continue
    live+="$sid|"; pids+="$pid|"
  done
  for pid in $running; do
    [[ "$pids" == *"|$pid|"* ]] || ! ps -p "$pid" >/dev/null 2>&1 || {
      warn "Claude temp: running claude $pid has no matching record, nothing swept"; return 0; }
  done

  # The subshell's cwd is the control: lsof must report the root itself or its listing is not usable.
  line=$(cd "$root" && lsof -nP -u "$UID" -Fn 2>/dev/null)
  [[ $'\n'"$line"$'\n' == *$'\n'"n$root"$'\n'* ]] || { warn "Claude temp: open-file control failed, nothing swept"; return 0; }
  open="|$(ROOT="n$root/" awk 'index($0, ENVIRON["ROOT"]) == 1 { split(substr($0, length(ENVIRON["ROOT"]) + 1), a, "/"); print a[1] "/" a[2] }' <<<"$line" | sort -u | tr '\n' '|')"

  local dir key id recent rc removed=0 kept=0 kb=0 size verb=removed others
  [[ "$dry" == --dry-run ]] && verb="would remove"
  keep() { skip "Claude temp: kept $1"; kept=$((kept + 1)); }
  for dir in "$root"/-*/*; do
    [[ -e "$dir" || -L "$dir" ]] || continue
    id=${dir##*/}; key=${dir#"$root"/}
    if [[ ! -d "$dir" || -L "$dir" || -L "${dir%/*}" || ! "$id" =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ ]]; then
      keep "$key (not a session folder)"; continue
    fi
    if [[ "$live" == *"|$id|"* ]]; then keep "$key (live session)"; continue; fi
    if [[ "$open" == *"|$key|"* ]]; then keep "$key (files open)"; continue; fi
    recent=$(find "$dir" -mmin "-$((days * 1440))" -print -quit 2>/dev/null); rc=$?
    if (( rc != 0 )) || [[ -n "$recent" ]]; then keep "$key (changed within $days days or unreadable)"; continue; fi
    size=$(du -sk "$dir" 2>/dev/null | awk '{print $1}')
    if [[ "$dry" == --dry-run ]] || rm -rf "$dir"; then
      ok "Claude temp: $verb $key (${size:-?} KB)"; removed=$((removed + 1)); kb=$((kb + ${size:-0}))
    else
      warn "Claude temp: removing $key failed"; kept=$((kept + 1))
    fi
  done
  others=$(find "$root" -mindepth 1 -maxdepth 1 ! -name '-*' 2>/dev/null | wc -l)
  ok "Claude temp: $verb $removed ($kb KB), kept $kept, ${others// /} other top-level entries left alone"
}

case "${1:-}" in
  "") ;;
  --dry-run) step "Claude Code temp folders (dry run)"; sweep_cc_tmp --dry-run; exit 0 ;;
  *) fail "usage: bench-clean [--dry-run]"; exit 2 ;;
esac

# Independent jobs (disjoint cache dirs + a .DS_Store sweep that only unlinks its
# own vanishing files): fan out to per-slot logs, then `wait`. Idiom: bench-export.
WORK=$(mktemp -d)
bg() {  # bg slot "label" cmd...
  local slot="$1" label="$2"; shift 2
  { if "$@" >/dev/null 2>&1; then ok "$label"; else warn "$label (skipped/failed)"; fi; } >"$WORK/$slot" 2>&1 &
}

step "Caches + .DS_Store (parallel)"
if have brew && brew_bottles_supported; then
  bg 1 "Homebrew cleanup"  brew cleanup -s
elif have brew; then
  brew_unsupported_notice >"$WORK/1" 2>&1   # printed in slot order by the cat below
fi
# `bun pm cache rm` demands a package.json in cwd, so target the cache dir
# directly (covers bunx too; it lives under the same path).
have bun  && bg 2 "Bun install cache" rm -rf "${BUN_INSTALL:-$HOME/.bun}/install/cache"
# No uv cache clean. It needs the cache lock, and this machine's Claude sessions hold it through
# their uv-launched MCP children, so from inside one the step cannot succeed by construction: every
# scheduled run reported the timeout. Clean it by hand from a plain shell if it ever needs it.
have fd   && bg 4 "Sweep .DS_Store" bash -c "fd -H -I -t f -g '.DS_Store' / \
  --exclude '*BACKUP*' --exclude '*timemachine*' --exclude '*TimeMachine*' \
  --exclude '/System/Volumes/Data' -X rm 2>/dev/null; true"
wait
cat "$WORK"/* 2>/dev/null
rm -rf "$WORK"

# Instant steps: sequential, parallelizing buys nothing.
run "Claude HTTP cache"  rm -rf "$HOME/Library/Application Support/Claude/Cache"
run "Claude code cache"  rm -rf "$HOME/Library/Application Support/Claude/Code Cache"

# JetBrains names every config/cache dir after product-info.json's dataDirectoryName,
# which is major.minor only (2026.2.2 lives in IntelliJIdea2026.2). Patch upgrades
# therefore reuse their dirs and only major ones strand the predecessor — silently, and
# for good. Read the live names off the installed apps so no version is pinned here.
sweep_jetbrains() {
  local roots=("$HOME/Library/Caches/JetBrains" "$HOME/Library/Logs/JetBrains" \
               "$HOME/Library/Application Support/JetBrains")
  local app pi name root d live="|" products="|" nlive=0 removed=0
  have jaq || { skip "JetBrains: jaq missing, version dirs not swept"; return 0; }
  for app in /Applications/*.app "$HOME/Applications"/*.app; do
    pi="$app/Contents/Resources/product-info.json"   # JetBrains-only file: its presence is the test
    [[ -f "$pi" ]] || continue                       # also absorbs an unmatched literal glob
    name=$(jaq -r '.dataDirectoryName // empty' "$pi" 2>/dev/null)
    [[ -n "$name" ]] && { live+="$name|"; products+="${name%%[0-9]*}|"; nlive=$((nlive + 1)); }
  done
  # Fail closed. An empty set means Toolbox is mid-update with the bundle gone, not that
  # every version dir is stale — sweeping on it would delete the live config.
  (( nlive )) || { skip "JetBrains: no IDE found, nothing swept"; return 0; }
  for root in "${roots[@]}"; do
    for d in "$root"/*/; do
      [[ -d "$d" ]] || continue
      name=$(basename "$d")
      # Only version-stamped names qualify. Toolbox, Daemon, Air and the lowercase infra
      # dirs never match, so whatever JetBrains adds next is safe by default.
      [[ "$name" =~ ^[A-Za-z]+[0-9]+(\.[0-9]+)+$ ]] || continue
      [[ "$live" == *"|$name|"* ]] && continue
      # Superseded means an older version of an installed product. A product with
      # no app found (uninstalled, or Toolbox in a custom folder) keeps its settings.
      [[ "$products" == *"|${name%%[0-9]*}|"* ]] || continue
      rm -rf "$d" && { ok "JetBrains: removed ${d%/}"; removed=$((removed + 1)); }
    done
  done
  # Named, not counted like the VS Code dedup: these carry settings, not just cache.
  (( removed )) || ok "JetBrains: no superseded version dirs"
}
step "JetBrains version dirs"; sweep_jetbrains

step "Claude Code temp folders"; sweep_cc_tmp

step "Done"
