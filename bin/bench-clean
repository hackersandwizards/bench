#!/usr/bin/env bash
# Reclaim disk: purge regenerable caches, dedup VS Code extensions, sweep .DS_Store.
# Removes only auto-regenerating caches and superseded files — never installed tools.
set -u

# shellcheck source-path=SCRIPTDIR
# shellcheck source=_lib.sh
. "$(dirname "$0")/_lib.sh"

rm_path() { [[ -e "$1" ]] && rm -rf "$1"; return 0; }

# Independent jobs (disjoint cache dirs + a .DS_Store sweep that only unlinks its
# own vanishing files) — fan out to per-slot logs, then `wait`. Idiom: bench-export.
WORK=$(mktemp -d)
bg() {  # bg slot "label" cmd...
  local slot="$1" label="$2"; shift 2
  { if "$@" >/dev/null 2>&1; then ok "$label"; else warn "$label (skipped/failed)"; fi; } >"$WORK/$slot" 2>&1 &
}

step "Caches + .DS_Store (parallel)"
have brew && bg 1 "Homebrew cleanup"  brew cleanup -s
# `bun pm cache rm` demands a package.json in cwd — target the cache dir directly
# instead (covers bunx too; it lives under the same path).
have bun  && bg 2 "Bun install cache" rm_path "${BUN_INSTALL:-$HOME/.bun}/install/cache"
have uv   && bg 3 "uv cache (full)"   env UV_LOCK_TIMEOUT=10 uv cache clean
bg 4 "Sweep .DS_Store" bash -c "fd -H -I -t f '.DS_Store' / \
  --exclude '*BACKUP*' --exclude '*timemachine*' --exclude '*TimeMachine*' \
  --exclude '/System/Volumes/Data' -x rm {} 2>/dev/null; true"
wait
cat "$WORK"/* 2>/dev/null
rm -rf "$WORK"

# Instant steps — sequential, no benefit to parallelizing.
run "Puppeteer Chromium" rm_path "$HOME/.cache/puppeteer"
run "Claude HTTP cache"  rm_path "$HOME/Library/Application Support/Claude/Cache"
run "Claude code cache"  rm_path "$HOME/Library/Application Support/Claude/Code Cache"

dedup_vscode() {
  local dir="$HOME/.vscode/extensions" manifest d name removed=0
  manifest="$dir/extensions.json"
  [[ -d "$dir" && -f "$manifest" ]] || { skip "VS Code: no extensions manifest"; return 0; }
  for d in "$dir"/*/; do
    name=$(basename "$d")
    grep -qF "$name" "$manifest" || { rm -rf "$d" && removed=$((removed + 1)); }
  done
  ok "VS Code: removed $removed orphaned extension version(s)"
}
step "VS Code extension dedup"; dedup_vscode

step "Done"
