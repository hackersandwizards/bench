#!/usr/bin/env bash
# Update brew, antidote plugins, language toolchains and global packages.
set -u

# shellcheck source-path=SCRIPTDIR
# shellcheck source=_lib.sh
. "$(dirname "$0")/_lib.sh"

if have brew && brew_bottles_supported; then
  run "Homebrew update"   brew update
  run "Homebrew upgrade"  brew upgrade
  run "Homebrew cleanup"  brew cleanup -s
elif have brew; then
  step "Homebrew"
  brew_unsupported_notice
fi

if [[ -f "$ANTIDOTE_SH" ]]; then
  run "Antidote plugins" zsh -c "source '$ANTIDOTE_SH' && antidote update"
  rm -f "$REPO_ROOT/plugins.zsh" "$REPO_ROOT/plugins-post.zsh"
  ok "Antidote static bundles invalidated (regenerate on next shell)"
fi

# Two outdated gems are left alone. rdoc belongs to the ruby formula: a `gem
# update` copy lands beside the bundled one, both load a rubygems_plugin.rb
# (~16 constant-redefinition warnings on every `gem` call), and the write into
# Homebrew's read-only plugin symlink fails. io-wait is deprecated, its
# functionality ships with Ruby, and each update re-prints the deprecation
# notice.
_gem_update_all() {
  gem outdated 2>/dev/null | awk '{print $1}' | grep -vxE 'rdoc|io-wait' | xargs -r gem update
}

if have gem; then
  run "RubyGems system"   gem update --system
  run "RubyGems all"      _gem_update_all
  run "RubyGems cleanup"  gem cleanup
fi

have pipx && run "pipx apps" pipx upgrade-all
have uv   && run "uv tools" uv tool upgrade --all
# No uv cache prune: same lock, same reason as the clean dropped from bin/bench-clean.

_pip_global_upgrade() {
  local managed; managed=$(pip_managed_names)
  [[ -z "$managed" ]] && return 0
  pip list --outdated --format=json 2>/dev/null \
    | jaq -r '.[].name' \
    | grep -ixFf <(printf '%s\n' "$managed") \
    | xargs -r pip install --upgrade
}

_pip_user_upgrade() {
  pip list --user --outdated --format=json 2>/dev/null \
    | jaq -r '.[].name' \
    | xargs -r pip install --user --upgrade
}

# jaq gated like every other tool: without it the pipelines would exit
# through xargs's 0 and print a false ok.
if have pip && have jaq; then
  run "Python pip globals"   _pip_global_upgrade
  run "Python pip user-site" _pip_user_upgrade
fi

# `sdk upgrade` installs the newer patch and leaves the old one on disk, so every
# candidate grows without bound. Keep the newest install per line; never touch what
# `current` points at. Uninstall is the one destructive step here, so it reports
# each removal by name and refuses anything it cannot prove is superseded.
sdk_prune() {
  local dir cand cur v line newest
  for dir in "$HOME/.sdkman/candidates"/*/; do
    [[ -d "$dir" ]] || continue
    cand=$(basename "$dir")
    cur=$(basename "$(readlink "$dir/current" 2>/dev/null)" 2>/dev/null)
    local versions=()
    for v in "$dir"*/; do
      v=$(basename "$v")
      [[ "$v" == current ]] || versions+=("$v")
    done
    (( ${#versions[@]} > 1 )) || continue
    for v in "${versions[@]}"; do
      line=$(sdk_line "$v")
      newest=$(printf '%s\n' "${versions[@]}" \
        | while read -r c; do [[ "$(sdk_line "$c")" == "$line" ]] && printf '%s\n' "$c"; done \
        | sort -V | tail -1)
      [[ "$v" == "$newest" || "$v" == "$cur" ]] && continue
      if sdk_run uninstall "$cand" "$v" >/dev/null 2>&1; then
        ok "pruned $cand $v (superseded by $newest)"
      else
        warn "prune $cand $v failed"
      fi
    done
  done
}

# `sdk` is a shell function, so `have sdk` is false until its init is sourced.
source_sdkman || true
if have sdk; then
  # Never block an unattended run on a prompt: auto-answer "yes" (newest as
  # default), regardless of the machine's etc/config. Export it for the Bash 3
  # compatibility wrapper, which runs SDKMAN in a Homebrew Bash child.
  export sdkman_auto_answer=true
  run "SDKMAN selfupdate" sdk_run selfupdate
  run "SDKMAN update"     sdk_run update
  run "SDKMAN upgrade"    sdk_run upgrade
  run "SDKMAN prune"      sdk_prune
fi

# `bun -g update --latest` writes `^` ranges. Re-add every global at @latest with
# --exact instead: it upgrades and pins in one step, so the manifest always names
# the version the MCP configs run through ~/.bun/bin.
_bun_globals_exact() {
  local specs
  specs=$(jaq -r '.dependencies | keys[] | . + "@latest"' "${BUN_INSTALL:-$HOME/.bun}/install/global/package.json") \
    && [[ -n "$specs" ]] || return 1
  xargs bun add -g --exact <<<"$specs"
}

have bun && run "Bun runtime" bun upgrade
have bun && have jaq && run "Bun globals" _bun_globals_exact

# `bun add -g` only bumps the pi CLI itself (@earendil-works/pi-coding-agent).
# pi's own extensions (npm:pi-antigravity etc., see `pi list`) live under a
# separate package manager and need their own update call.
have pi && run "pi extensions" pi update --extensions

have npm-check && \
  run "npm globals" env NPM_CHECK_INSTALLER=npm npm-check --global --update-all --save-exact

step "Done"
