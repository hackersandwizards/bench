#!/usr/bin/env bash
# Update brew, antidote plugins, language toolchains and global packages.
set -u

# shellcheck source-path=SCRIPTDIR
# shellcheck source=_lib.sh
. "$(dirname "$0")/_lib.sh"

if have brew && brew_bottles_supported; then
  run "Homebrew update"   brew update
  run "Homebrew upgrade"  brew upgrade
  run "Homebrew cleanup"  brew cleanup -s
elif have brew; then
  step "Homebrew"
  brew_unsupported_notice
fi

if [[ -f "$ANTIDOTE_SH" ]]; then
  run "Antidote plugins" zsh -c "source '$ANTIDOTE_SH' && antidote update"
  rm -f "$REPO_ROOT/plugins.zsh" "$REPO_ROOT/plugins-post.zsh"
  ok "Antidote static bundles invalidated (regenerate on next shell)"
fi

if have gem; then
  run "RubyGems system"   gem update --system
  run "RubyGems all"      gem update
  run "RubyGems cleanup"  gem cleanup
fi

have pipx && run "pipx apps" pipx upgrade-all
have uv   && run "uv tools" uv tool upgrade --all
have uv   && run "uv cache prune" env UV_LOCK_TIMEOUT=10 uv cache prune

_pip_managed_names() {
  # pip-managed installs have a RECORD file; brew-installed ones don't, so this
  # filters brew's packages out.
  python3 -c 'import importlib.metadata as m
print("\n".join(d.metadata["Name"] for d in m.distributions() if d.read_text("RECORD")))' 2>/dev/null
}

_pip_global_upgrade() {
  local managed; managed=$(_pip_managed_names)
  [[ -z "$managed" ]] && return 0
  pip list --outdated --format=json 2>/dev/null \
    | jaq -r '.[].name' \
    | grep -ixFf <(printf '%s\n' "$managed") \
    | xargs -r pip install --upgrade
}

_pip_user_upgrade() {
  pip list --user --outdated --format=json 2>/dev/null \
    | jaq -r '.[].name' \
    | xargs -r pip install --user --upgrade
}

# jaq gated like every other tool: without it the pipelines would exit
# through xargs's 0 and print a false ok.
if have pip && have jaq; then
  run "Python pip globals"   _pip_global_upgrade
  run "Python pip user-site" _pip_user_upgrade
fi

# `sdk` is a shell function, so `have sdk` is false until its init is sourced.
source_sdkman || true
if have sdk; then
  # Never block an unattended run on a prompt: auto-answer "yes" (newest as
  # default), regardless of the machine's etc/config. `sdk` is a function in
  # this shell, so it reads this variable directly.
  # shellcheck disable=SC2034  # consumed by the sourced `sdk` function
  sdkman_auto_answer=true
  run "SDKMAN selfupdate" sdk_run selfupdate
  run "SDKMAN update"     sdk_run update
  run "SDKMAN upgrade"    sdk_run upgrade
fi

if have bun; then
  run "Bun runtime"       bun upgrade
  run "Bun globals"       bun -g update --latest
fi

have npm-check && \
  run "npm globals" env NPM_CHECK_INSTALLER=npm npm-check --global --update-all --save-exact

# ---------- Converge to repo defaults ----------
# Benedikt maintains the defaults (bench-export on his machine -> docs/);
# everyone else re-applies them here after a git pull. Every action asks, and
# ask() declines on EOF, so unattended runs skip this section cleanly.
step "Converge machine state to repo defaults"
if have dockutil && [[ -s "$REPO_ROOT/docs/dock.txt" ]] \
    && dock_items=$(parse_dock "$REPO_ROOT/docs/dock.txt") && [[ -n "$dock_items" ]] \
    && ask "Replace the Dock with docs/dock.txt?"; then
  apply_dock "$dock_items"
else
  skip "Dock left as is"
fi
if have mysides && [[ -s "$REPO_ROOT/docs/finder-sidebar.txt" ]] \
    && sidebar_snap=$(parse_sidebar "$REPO_ROOT/docs/finder-sidebar.txt") && [[ -n "$sidebar_snap" ]] \
    && ask "Mirror the Finder sidebar to docs/finder-sidebar.txt?"; then
  apply_sidebar "$sidebar_snap"
else
  skip "Finder sidebar left as is"
fi
if [[ -s "$REPO_ROOT/docs/moom.plist" ]] && ask "Import Moom settings from docs/moom.plist?"; then
  apply_moom "$REPO_ROOT/docs/moom.plist"
else
  skip "Moom left as is"
fi
if [[ -s "$REPO_ROOT/docs/repos.txt" ]] && ask "Clone missing default repos from docs/repos.txt?"; then
  clone_repos "$REPO_ROOT/docs/repos.txt"
else
  skip "Default repos left as is"
fi
if ask "Run ./macos.sh? (system defaults + default apps)"; then
  "$REPO_ROOT/macos.sh" || warn "macos.sh exited with an error partway"
else
  skip "macos.sh skipped"
fi

step "Done"
