{
  "subagentPromptCacheTtl": "1h",
  "statusLine": {
    "type": "command",
    "command": "bash .claude/statusline-command.sh"
  },
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "opus",
    "DISABLE_ERROR_REPORTING": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "CLAUDE_CODE_ENABLE_AWAY_SUMMARY": "0",
    "CLAUDE_CODE_ADDITIONAL_DIRECTORIES_CLAUDE_MD": "1",
    "CLAUDE_CODE_FORK_SUBAGENT": "1",
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "2",
    "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "1"
  },
  "permissions": {
    "defaultMode": "bypassPermissions",
    "deny": [
      "Artifact",
      "ArtifactComments",
      "ArtifactData",
      "mcp__claude_ai_Claude_Docs__*",
      "mcp__1a59c906-04da-521d-bda7-7f71b9f9e01c__*",
      "mcp__claude_ai_Gmail__*",
      "mcp__e903bc31-5c92-4368-b145-cc7e94100c64__*",
      "mcp__claude_ai_Google_Calendar__*",
      "mcp__2f44548d-7515-40a6-be70-86e95edf5a87__*",
      "mcp__claude_ai_Google_Drive__*",
      "mcp__d2740204-6326-4665-86e9-76fca0446527__*",
      "mcp__claude_ai_Google_Docs__*",
      "mcp__aeeb1f09-e80e-4055-9dfa-e0a61a0a4a0f__*",
      "mcp__claude_ai_Google_Sheets__*",
      "mcp__c38bff8e-fdfa-4c7e-86ce-6d1111bdb651__*",
      "mcp__claude_ai_Google_Slides__*",
      "mcp__709a845e-e7bb-4fbb-bf2b-46770a8f5d97__*",
      "mcp__claude_ai_Claude_Data__*",
      "mcp__29882e05-23cb-5f75-9c2d-95ba70d8644d__*",
      "mcp__claude_ai_Meetings__*",
      "mcp__7a9fad4d-da65-586f-98d6-b143a5d6d9f8__*",
      "mcp__dc748e22-4910-4762-ae74-bb45fc292540__*"
    ]
  },
  "tui": "fullscreen",
  "autoMemoryEnabled": false,
  "autoDreamEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": true,
  "enabledMcpjsonServers": [],
  "model": "opus",
  "effortLevel": "medium",
  "claudeMdExcludes": [
    "/Users/*/.claude/rules/**",
    "/home/*/.claude/rules/**"
  ],
  "advisorModel": "claude-fable-5-2"
}
